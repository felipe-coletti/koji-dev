// What Windows does not give as the C libraries of Unix do, for the library on Windows (`match
// (system.os)` elsewhere chooses these there, see "Code for one system" in doc/design.md): the
// writes and reads of several buffers, a line of a stream, the entries of a directory (by
// _findfirst64 of the C library of Windows), and `memmem`. Each body is empty on the other systems
// (their branches of Windows are not compiled), so that they need none of these functions.

import system
import { SocketNumbers } from 'koji:sockets'
import { Address, CInt, CSize, allocate, distance, floatControl, free, isNull, nullAddress, offset, read, taskEntry, write } from 'koji:unsafe'

// The C library of Windows (ucrtbase).
extern function windowsWrite(fd: CInt, bytes: Address, size: CInt): CInt from '_write'
extern function windowsRead(fd: CInt, bytes: Address, size: CInt): CInt from '_read'
extern function fgetc(stream: Address): CInt
extern function realloc(memory: Address, size: CSize): Address
extern function strlen(text: Address): CSize
extern function memcpy(target: Address, source: Address, size: CSize): Address
extern function memcmp(a: Address, b: Address, size: CSize): CInt
extern function memchr(bytes: Address, value: CInt, size: CSize): Address
extern function memmem(haystack: Address, haystackSize: CSize, needle: Address, needleSize: CSize): Address
extern function findFirst(pattern: Address, found: Address): int from '_findfirst64'
extern function findNext(handle: int, found: Address): CInt from '_findnext64'
extern function findClose(handle: int): CInt from '_findclose'
// kernel32.
extern function WaitForSingleObject(handle: Address, milliseconds: CInt): CInt
extern function GetExitCodeProcess(process: Address, code: Address): CInt
extern function CloseHandle(handle: Address): CInt

// `writev`: the buffers (an address and a size each) written in turn: the bytes written, or -1
// when none could be.
extern function koji_windows_writev(fd: CInt, buffers: Address, count: CInt): int {
    if (system.os != system.Windows) { return -1 }

    mut total = 0

    for i in range(count) {
        immut at: Address = read(buffers, 16 * i)
        immut size: int = read(buffers, 16 * i + 8)

        if (size == 0) { continue }

        immut done = windowsWrite(fd, at, size)

        if (done < 0) { return if (total > 0) { total } else { -1 } }

        total += done

        if (done < size) { return total }
    }

    return total
}

// `readv`: into the first buffer that has room (fewer bytes than asked is allowed).
extern function koji_windows_readv(fd: CInt, buffers: Address, count: CInt): int {
    if (system.os != system.Windows) { return -1 }

    for i in range(count) {
        immut at: Address = read(buffers, 16 * i)
        immut size: int = read(buffers, 16 * i + 8)

        if (size > 0) { return windowsRead(fd, at, size) }
    }

    return 0
}

// `getline`: a line of the stream with its line break, in the block at `*line` of `*capacity` bytes
// (grown by realloc, and ended by 0): its size, or -1 at the end of the stream.
extern function koji_windows_getline(line: Address, capacity: Address, stream: Address): int {
    if (system.os != system.Windows) { return -1 }

    mut block: Address = read(line, 0)
    mut room: int = read(capacity, 0)
    mut size = 0

    while (true) {
        immut c = fgetc(stream)

        if (c < 0) { break }

        if (size + 2 > room) {
            room = if (room < 64) { 128 } else { room * 2 }
            block = realloc(block, room)
            write(line, 0, block)
            write(capacity, 0, room)
        }

        write(block, size, byte(c & 0xFF))
        size += 1

        if (c == 10) { break }
    }

    if (size == 0) { return -1 }

    write(block, size, byte(0))
    return size
}

// The entries of a directory: a block of the handle of _findfirst64, whether the entry it found is
// yet to be given, and that entry (a `struct __finddata64_t`, its name at 40).
extern function koji_windows_opendir(path: Address): Address {
    if (system.os != system.Windows) { return nullAddress() }

    // The pattern: the path, then `\\*`.
    immut length = strlen(path)
    immut pattern = allocate(length + 3)
    memcpy(pattern, path, length)
    write(pattern, length, byte(92))
    write(pattern, length + 1, byte(42))
    write(pattern, length + 2, byte(0))
    immut block = allocate(16 + 304)
    immut handle = findFirst(pattern, offset(block, 16))
    free(pattern)

    if (handle == -1) {
        free(block)
        return nullAddress()
    }

    write(block, 0, handle)
    write(block, 8, 1)
    return block
}

// The next entry, or none: its name at 40.
extern function koji_windows_readdir(directory: Address): Address {
    if (system.os != system.Windows) { return nullAddress() }

    immut pending: int = read(directory, 8)

    if (pending == 1) {
        write(directory, 8, 0)
        return offset(directory, 16)
    }

    immut handle: int = read(directory, 0)

    if (findNext(handle, offset(directory, 16)) != 0) { return nullAddress() }

    return offset(directory, 16)
}

extern function koji_windows_closedir(directory: Address): CInt {
    if (system.os != system.Windows) { return -1 }

    immut handle: int = read(directory, 0)
    findClose(handle)
    free(directory)
    return 0
}

// `memmem`: the first place of the needle in the haystack, or none (that of the C library, but on
// Windows). An empty needle is at the start (glibc says so, macOS's says it is nowhere).
extern function koji_find_bytes(haystack: Address, haystackSize: CSize, needle: Address, needleSize: CSize): Address {
    if (needleSize == 0) { return haystack }

    return if (system.os == system.Windows) { windowsFind(haystack, haystackSize, needle, needleSize) } else { memmem(haystack, haystackSize, needle, needleSize) }
}

function windowsFind(haystack: Address, haystackSize: CSize, needle: Address, needleSize: CSize): Address {
    if (needleSize == 0) { return haystack }

    immut first: byte = read(needle, 0)
    mut at = 0

    while (at + needleSize <= haystackSize) {
        immut found = memchr(offset(haystack, at), int(first), haystackSize - needleSize - at + 1)

        if (isNull(found)) { return nullAddress() }

        immut place = distance(haystack, found)

        if (memcmp(found, needle, needleSize) == 0) { return found }

        at = place + 1
    }

    return nullAddress()
}

// `waitpid` of a process (its handle: see windowsSpawn of std/system.kj): its exit code in the
// status as `waitpid` gives it (the code in the second byte), the handle closed.
extern function koji_windows_waitpid(pid: int, status: Address, options: CInt): int {
    if (system.os != system.Windows) { return -1 }

    immut process = offset(nullAddress(), pid)
    // INFINITE
    WaitForSingleObject(process, -1)
    immut code = allocate(8)
    write(code, 0, 0)
    GetExitCodeProcess(process, code)
    immut exit: int = read(code, 0)
    free(code)
    CloseHandle(process)
    write(status, 0, (exit & 0xFF) << 8)
    return pid
}

// The tasks (koji:task): their stacks, the clock, sleeps and the sockets they wait for.

extern function VirtualAlloc(address: Address, size: CSize, kind: CInt, protection: CInt): Address
extern function VirtualProtect(address: Address, size: CSize, protection: CInt, old: Address): CInt
extern function VirtualFree(address: Address, size: CSize, kind: CInt): CInt
extern function QueryPerformanceCounter(count: Address): CInt
extern function QueryPerformanceFrequency(frequency: Address): CInt
extern function Sleep(milliseconds: CInt)
extern function WSAPoll(fds: Address, count: CInt, milliseconds: CInt): CInt
extern function PeekNamedPipe(pipe: Address, buffer: Address, size: CInt, read: Address, available: Address, left: Address): CInt
extern function windowsHandle(fd: CInt): Address from '_get_osfhandle'
extern function koji_monotonic_nanoseconds(): int

// A stack of `size` bytes above a guard of `guard`: its memory given at once (MEM_COMMIT |
// MEM_RESERVE, PAGE_READWRITE), the guard PAGE_NOACCESS.
export function windowsStackNew(size: int, guard: int): Address {
    immut reserved = VirtualAlloc(nullAddress(), size + guard, 0x3000, 4)

    if (isNull(reserved)) { return nullAddress() }

    immut old = allocate(8)
    immut guarded = VirtualProtect(reserved, guard, 1, old) != 0
    free(old)

    if (not guarded) {
        VirtualFree(reserved, 0, 0x8000)
        return nullAddress()
    }

    return offset(reserved, guard)
}

// MEM_RELEASE.
export function windowsStackFree(stack: Address, guard: int) {
    VirtualFree(offset(stack, -guard), 0, 0x8000)
}

// The top of a new stack (x86-64) for `switchStacks`: as on the others, with the limits of the
// stack in the block of the thread too (NT_TIB: StackLimit, StackBase), which the functions of the
// system check.
export function windowsStackStart(stack: Address, size: int, task: int): Address {
    immut sp = offset(stack, size - 16 - 88)

    for word in range(11) {
        write(sp, 8 * word, 0)
    }

    write(sp, 0, floatControl())
    write(sp, 8, stack)
    write(sp, 16, offset(stack, size))
    write(sp, 56, task)
    write(sp, 72, taskEntry())
    return sp
}

// The nanoseconds of the counter of performance and its frequency, at `words`.
export function windowsNanoseconds(words: Address): int {
    QueryPerformanceCounter(words)
    QueryPerformanceFrequency(offset(words, 8))
    immut count: int = read(words, 0)
    immut frequency: int = read(words, 8)
    return count / frequency * 1000000000 + count % frequency * 1000000000 / frequency
}

// Sleeps at least `nanoseconds` (Sleep counts milliseconds).
export function windowsSleep(nanoseconds: int) {
    Sleep((nanoseconds + 999999) / 1000000)
}

// The sockets watched (twice their numbers, and 1 for those to write), until ready: one poller,
// no handle.
mut windowsWatched: int[] = []

export function windowsPollerWatch(fd: int, writing: boolean): int {
    immut entry = fd * 2 + (if (writing) { 1 } else { 0 })

    if (not (entry in windowsWatched)) { windowsWatched.push(entry) }

    return 0
}

// WSAPoll of the sockets watched (a WSAPOLLFD each: the socket, the events POLLRDNORM or
// POLLWRNORM, those that came): how many are ready, their numbers at `ready`, which are watched no
// more. The pipe of the jobs done (`jobsDone`, -1 before there is one) is no socket: it is looked
// at (PeekNamedPipe) between waits of 10 ms at most; with nothing else to wait for, a sleep.
export function windowsPollerWait(milliseconds: int, ready: Address, most: int, jobsDone: int): int {
    immut deadline = if (milliseconds < 0) { -1 } else { koji_monotonic_nanoseconds() + milliseconds * 1000000 }
    immut pipeEntry = jobsDone * 2

    while (true) {
        mut found = 0
        mut kept: int[] = []
        mut sockets: int[] = []

        for entry in windowsWatched {
            if (jobsDone >= 0 and entry == pipeEntry) {
                if (pipeWaiting(jobsDone) and found < most) {
                    write(ready, 8 * found, jobsDone)
                    found += 1
                } else {
                    kept.push(entry)
                }
            } else {
                sockets.push(entry)
            }
        }

        immut left = if (deadline < 0) { -1 } else { (deadline - koji_monotonic_nanoseconds() + 999999) / 1000000 }
        immut piped = kept.length() > 0
        immut span = if (found > 0) { 0 } else { if (piped and (left < 0 or left > 10)) { 10 } else { if (left < 0) { -1 } else { left } } }

        if (sockets.length() > 0) {
            immut fds = allocate(16 * sockets.length())

            for i in range(sockets.length()) {
                write(fds, 16 * i, sockets[i] / 2)
                write(fds, 16 * i + 8, if (sockets[i] % 2 == 1) { 0x10 } else { 0x100 })
            }

            immut answer = WSAPoll(fds, sockets.length(), span)

            if (answer < 0) {
                free(fds)
                return -1
            }

            for i in range(sockets.length()) {
                immut events: int = read(fds, 16 * i + 8)

                if ((events >> 16) & 0xFFFF != 0 and found < most) {
                    write(ready, 8 * found, sockets[i] / 2)
                    found += 1
                } else {
                    kept.push(sockets[i])
                }
            }

            free(fds)
        } else {
            if (span > 0) { Sleep(span) }
        }

        windowsWatched = kept

        if (found > 0 or span == 0 and not piped) { return found }

        if (deadline >= 0 and koji_monotonic_nanoseconds() >= deadline) { return 0 }

        if (span < 0) { return 0 }
    }

    return 0
}

// Whether bytes wait in a pipe of the C library of Windows.
function pipeWaiting(fd: int): boolean {
    immut waiting = allocate(8)
    write(waiting, 0, 0)
    PeekNamedPipe(windowsHandle(fd), nullAddress(), 0, nullAddress(), waiting, nullAddress())
    immut available: int = read(waiting, 0)
    free(waiting)
    return available & 0xFFFFFFFF > 0
}

// The sockets (koji:net): Winsock.

extern function WSAStartup(version: CInt, data: Address): CInt
extern function WSAGetLastError(): CInt
extern function closesocket(fd: CInt): CInt
extern function ioctlsocket(fd: CInt, command: CInt, argument: Address): CInt
extern function windowsErrnoPlace(): Address from '_errno'
// They give an int of C (32 bits), not a size.
extern function windowsSendC(fd: CInt, bytes: Address, size: CInt, flags: CInt): CInt from 'send'
extern function windowsRecvC(fd: CInt, bytes: Address, size: CInt, flags: CInt): CInt from 'recv'

// The numbers of the sockets: Winsock's errors (WSAEWOULDBLOCK, which a connection under way gives
// too, WSAETIMEDOUT); its sockets never wait, no flag needed (FIONBIO sets them).
export function windowsSockets(): SocketNumbers {
    return { level: 0xFFFF, reuseAddress: 4, socketError: 0x1007, noSignal: 0, dontWait: 0, nonBlocking: 0, wouldBlock: 10035, inProgress: 10035, timedOut: 10060, addressAt: 32, noPipeSignalOption: 0, addressLength: false, acceptedInherits: false }
}

// Winsock, started before the first socket.
mut winsockStarted = false

export function windowsSocketsStart() {
    if (winsockStarted) { return }

    immut data = allocate(512)
    WSAStartup(0x0202, data)
    free(data)
    winsockStarted = true
}

// The error of the last call of the sockets: Winsock's own.
export function windowsSocketError(): int {
    return WSAGetLastError()
}

// A socket waits or not (FIONBIO).
export function windowsSetWaiting(fd: int, waiting: boolean) {
    immut mode = allocate(8)
    write(mode, 0, if (waiting) { 0 } else { 1 })
    ioctlsocket(fd, 0x8004667E, mode)
    free(mode)
}

export function windowsCloseSocket(fd: int) {
    closesocket(fd)
}

export function windowsSend(fd: int, bytes: Address, size: int): int {
    return windowsSendC(fd, bytes, size, 0)
}

export function windowsReceive(fd: int, bytes: Address, size: int): int {
    return windowsRecvC(fd, bytes, size, 0)
}

// The place of errno (_errno).
export function windowsErrno(): Address {
    return windowsErrnoPlace()
}

// The message of an error of the names (Windows has no `gai_strerror` in its DLLs): the code of
// Winsock, as a string of C that stays.
export function windowsDnsMessage(code: int): Address {
    immut text = `the name could not be resolved (error ${code} of Winsock)`
    immut size = text.length()
    immut bytes = allocate(size + 1)
    mut at = 0

    for c in text.chars() {
        write(bytes, at, byte(c.code() & 0xFF))
        at += 1
    }

    write(bytes, size, byte(0))
    return bytes
}
