// The functions of floats that the C library gave (its `libm` and `strtod`), written in Koji: the
// rounding to integers, the absolute value and the remainder, exact, from the bits; the square
// root, correctly rounded (as IEEE 754 asks); the logarithms, in double-double, and the power of
// fdlibm (the library of Sun on which most C libraries build theirs) corrected by them, correctly
// rounded but in rare cases; and the float of a decimal text, correctly rounded. The constants
// are written in hexadecimal, exactly.

import { Address, U128, floatBits, floatOfBits, leadingZeros, lowWord, read, wide } from 'koji:unsafe'

// The high 32 bits of a float, signed, and its low 32 bits (fdlibm's __HI and __LO).
function high(x: float): int {
    return floatBits(x) >> 32
}

function low(x: float): int {
    return floatBits(x) & 0xFFFFFFFF
}

// A float of these high and low words.
function fromWords(hi: int, lo: int): float {
    return floatOfBits((hi << 32) | (lo & 0xFFFFFFFF))
}

function withHigh(x: float, hi: int): float {
    return fromWords(hi, low(x))
}

function withLow(x: float, lo: int): float {
    return fromWords(high(x), lo)
}

// Infinity and zero with a sign: the results beyond the floats, which the callers check (an
// operation of Koji that gives an infinity panics; these are made from their bits).
function infinity(negative: boolean): float {
    return floatOfBits(0x7FF0000000000000 | signOf(negative))
}

function signedZero(negative: boolean): float {
    return floatOfBits(signOf(negative))
}

// The sign bit of a float, set when `negative`.
function signOf(negative: boolean): int {
    return if (negative) { -9223372036854775807 - 1 } else { 0 }
}

// Rounding to integers

// The integer part of `x`, with its sign (`trunc(-0.5)` is -0).
extern function koji_float_trunc(x: float): float {
    immut bits = floatBits(x)
    immut exponent = ((bits >> 52) & 0x7FF) - 1023

    if (exponent < 0) { return floatOfBits(bits & (-9223372036854775807 - 1)) }

    if (exponent >= 52) { return x }

    immut fraction = (1 << (52 - exponent)) - 1
    return floatOfBits(bits & ~fraction)
}

extern function koji_float_floor(x: float): float {
    immut whole = koji_float_trunc(x)
    return if (x < whole) { whole - 0x1p0 } else { whole }
}

extern function koji_float_ceil(x: float): float {
    immut whole = koji_float_trunc(x)
    return if (x > whole) { whole + 0x1p0 } else { whole }
}

// The nearest integer, halfway cases away from zero (`round(2.5)` is 3, `round(-2.5)` is -3).
extern function koji_float_round(x: float): float {
    immut whole = koji_float_trunc(x)
    // Exact: `x` and its integer part are in the same binade or next to it.
    immut rest = x - whole

    if (rest >= 0x1p-1) { return whole + 0x1p0 }

    if (rest <= -0x1p-1) { return whole - 0x1p0 }

    return whole
}

extern function koji_float_abs(x: float): float {
    return floatOfBits(floatBits(x) & 0x7FFFFFFFFFFFFFFF)
}

// The remainder of `x` divided by `y` (not 0), with the sign of `x`, as `%` gives it (C's `fmod`):
// exact, from the mantissas as integers, the power of 2 between them taken 10 bits at a time.
extern function koji_float_remainder(x: float, y: float): float {
    immut negative = x < float(0) or (x == float(0) and floatBits(x) < 0)

    if (koji_float_abs(x) < koji_float_abs(y)) { return x }

    immut dividend = floatBits(x)
    immut divisor = floatBits(y)
    immut divisorMantissa = mantissaOf(divisor)
    mut rest = mantissaOf(dividend) % divisorMantissa
    mut gap = exponentOf(dividend) - exponentOf(divisor)

    while (gap > 0) {
        immut step = if (gap < 10) { gap } else { 10 }
        rest = (rest << step) % divisorMantissa
        gap -= step
    }

    return nearest(wide(rest, 0), exponentOf(divisor), false, negative)
}

// The mantissa of a float as an integer, and its power of 2: the float is mantissa * 2^exponent.
function mantissaOf(bits: int): int {
    immut fraction = bits & 0xFFFFFFFFFFFFF
    return if (((bits >> 52) & 0x7FF) == 0) { fraction } else { fraction | (1 << 52) }
}

function exponentOf(bits: int): int {
    immut field = (bits >> 52) & 0x7FF
    return if (field == 0) { -1074 } else { field - 1075 }
}

// The nearest float to `mantissa` times 2^`exponent` (`sticky`: something not zero below the bits
// of `mantissa`), rounded half to even, as a subnormal float or an infinity when it is one.
function nearest(mantissa: U128, exponent: int, sticky: boolean, negative: boolean): float {
    if (mantissa == 0) { return signedZero(negative) }

    immut length = 128 - leadingZeros(mantissa)
    immut magnitude = length - 1 + exponent

    if (magnitude > 1023) { return infinity(negative) }

    // The bits a float keeps of it: 53, fewer for a subnormal.
    immut precision = if (magnitude < -1022) { 53 - (-1022 - magnitude) } else { 53 }

    if (precision < 0) { return signedZero(negative) }

    immut shift = length - precision
    mut kept: U128 = 0
    mut scale = exponent

    if (shift <= 0) {
        kept = mantissa << wide(-shift, 0)
        scale += shift
    } else {
        kept = mantissa >> wide(shift, 0)
        immut one: U128 = 1
        immut rest = mantissa & ((one << wide(shift, 0)) - 1)
        immut half = one << wide(shift - 1, 0)

        if (rest > half or (rest == half and (sticky or (kept & 1) == 1))) { kept += 1 }

        scale += shift
    }

    immut top: U128 = 1
    immut limit = top << 53

    if (kept == limit) {
        kept = kept >> 1
        scale += 1
    }

    immut q = lowWord(kept)
    immut sign = signOf(negative)

    // A subnormal: the bits of the mantissa alone.
    if (q < (1 << 52)) { return floatOfBits(sign | q) }

    immut biased = scale + 52 + 1023

    if (biased >= 2047) { return infinity(negative) }

    return floatOfBits(sign | (biased << 52) | (q & 0xFFFFFFFFFFFFF))
}

// The square root of `x` (0 or more), correctly rounded: the root of its mantissa, as an integer
// of 55 bits from one of 110, and whether something is left.
extern function koji_float_sqrt(x: float): float {
    if (x == float(0)) { return x }

    immut bits = floatBits(x)
    mut field = (bits >> 52) & 0x7FF
    mut mantissa = bits & 0xFFFFFFFFFFFFF

    // x = mantissa * 2^exponent, the mantissa an integer.
    if (field == 0) { field = 1 } else { mantissa = mantissa | (1 << 52) }

    mut exponent = field - 1075

    if (exponent % 2 != 0) {
        mantissa = mantissa << 1
        exponent -= 1
    }

    // Scaled to some 110 bits (an even shift), for a root of 55.
    mut shift = 110 - (128 - leadingZeros(wide(mantissa, 0)))

    if (shift % 2 != 0) { shift += 1 }

    immut scaled = wide(mantissa, 0) << wide(shift, 0)
    immut root = integerRoot(scaled)
    immut sticky = root * root != scaled
    return nearest(root, (exponent - shift) / 2, sticky, false)
}

// The integer square root of `n`, rounded down (bit by bit).
function integerRoot(n: U128): U128 {
    mut rest = n
    mut root: U128 = 0
    mut bit: U128 = 1
    bit = bit << 126

    while (bit > rest) {
        bit = bit >> 2
    }

    while (bit != 0) {
        if (rest >= root + bit) {
            rest -= root + bit
            root = (root >> 1) + bit
        } else {
            root = root >> 1
        }

        bit = bit >> 2
    }

    return root
}

// Logarithms

// The natural logarithm of `x` (more than 0), correctly rounded but in rare cases: the high part of
// `logTwo`.
extern function koji_float_log(x: float): float {
    if (x == float(0)) { return infinity(true) }

    mut high = float(0)
    mut low = float(0)
    logTwo(x, mut high, mut low)
    return high
}

// The logarithm in base 10 of `x` (more than 0): `logTwo` times 1 / ln 10, in double-double.
extern function koji_float_log10(x: float): float {
    if (x == float(0)) { return infinity(true) }

    mut high = float(0)
    mut low = float(0)
    logTwo(x, mut high, mut low)
    doubleProduct(high, low, 0x1.bcb7b1526e50ep-2, 0x1.95355baaafad3p-57, mut high, mut low)
    return high
}

// Powers (fdlibm's e_pow.c)

// `base` to the power `exponent`, in the real numbers: the callers leave out a negative base with
// an exponent that is not an integer, and 0 to a negative power. An infinity, or 0, when the
// result is beyond the floats. Correctly rounded but in rare cases: fdlibm's power, within 1 ulp,
// and, when it is close to the middle of two floats, corrected by what it is off by,
// `y log x - log r`, in double-double (about 2^-80 for each logarithm).
extern function koji_float_power(x: float, y: float): float {
    mut tail = float(0)
    immut nearly = nearlyPower(x, y, mut tail)
    immut magnitude = koji_float_abs(nearly)

    // A result that fdlibm rounds once: x^1, 1^y, the square root, x * x (below 2^511, where it
    // fits); and 1 / x, which fdlibm leaves to its general way below 2^-1023.
    if (y == 0x1p0 or x == 0x1p0 or (y == 0x1p-1 and x >= float(0)) or (y == 0x1p1 and koji_float_abs(x) < 0x1p511)) { return nearly }

    if (y == -0x1p0 and koji_float_abs(x) > 0x1p-1024) { return 0x1p0 / x }

    // fdlibm's 0 below the floats: the smallest subnormal when the result is more than half of it
    // (then exactly 2^-1074 e^off, more than 2^-1075).
    if (magnitude == float(0) and x != float(0) and koji_float_abs(y) <= 0x1p64) {
        if (offFrom(x, y, 0x1p-1074) <= -0x1.62e42fefa39efp-1) { return nearly }

        return if (floatBits(nearly) < 0) { -0x1p-1074 } else { 0x1p-1074 }
    }

    if (magnitude == float(0) or magnitude > 0x1.fffffffffffffp1023 or koji_float_abs(y) > 0x1p64) { return nearly }

    // fdlibm's result, when what its last rounding left out is within 0.3 ulp of it: its own error
    // stays below 0.13 ulp (measured against the exact results), so the rounding is the right one.
    if (koji_float_abs(tail) < 0x1.3333333333333p-2) { return nearly }

    immut off = offFrom(x, y, magnitude)
    // A subnormal result: an ulp is a large part of it, so the correction is r (e^off - 1), which
    // rounds once, to the subnormals (r is one of them).
    if (magnitude < 0x1p-1022) {
        immut grown = off * (0x1p0 + off * (0x1p-1 + off * (0x1.5555555555555p-3 + off * (0x1.5555555555555p-5 + off * (0x1.1111111111111p-7 + off * 0x1.6c16c16c16c17p-10)))))
        immut subnormal = magnitude + magnitude * grown
        return if (nearly < float(0)) { -subnormal } else { subnormal }
    }

    // Scaled up by 2^54 for a small result, whose correction would be a subnormal (fewer bits).
    immut small = magnitude < 0x1p-968
    immut scaled = if (small) { magnitude * 0x1p54 } else { magnitude }
    immut correction = scaled * off

    // Rounded up beyond the floats.
    if (magnitude == 0x1.fffffffffffffp1023 and correction >= 0x1p970) { return infinity(nearly < float(0)) }

    immut corrected = if (small) { (scaled + correction) * 0x1p-54 } else { scaled + correction }
    return if (nearly < float(0)) { -corrected } else { corrected }
}

// y log |x| - log r: the relative error of r as |x|^y, in double-double (the high parts are
// close: their difference is exact).
function offFrom(x: float, y: float, r: float): float {
    mut logHigh = float(0)
    mut logLow = float(0)
    logTwo(koji_float_abs(x), mut logHigh, mut logLow)
    mut wantedHigh = float(0)
    mut wantedLow = float(0)
    twoProduct(y, logHigh, mut wantedHigh, mut wantedLow)
    wantedLow += y * logLow
    mut gotHigh = float(0)
    mut gotLow = float(0)
    logTwo(r, mut gotHigh, mut gotLow)
    return (wantedHigh - gotHigh) + (wantedLow - gotLow)
}

// The natural logarithm of `x` (more than 0) in double-double, high + low, within about 2^-80 of
// log m: x = 2^k m (m from sqrt(2) / 2 to sqrt(2)), and log(m) = 2 atanh(s) = 2s + 2s^3 / 3 +
// 2s^5 / 5 + ..., where s = (m - 1) / (m + 1), the terms to s^9 in double-double. (y log x
// multiplies its error by y, for a power.)
function logTwo(given: float, mut high: float, mut low: float) {
    mut x = given
    mut k = 0

    if (x < 0x1p-1022) {
        x = x * 0x1p54
        k = -54
    }

    immut bits = floatBits(x)
    k += ((bits >> 52) & 0x7FF) - 1023
    mut m = floatOfBits((bits & 0xFFFFFFFFFFFFF) | 0x3FF0000000000000)

    if (m > 0x1.6a09e667f3bcdp0) {
        m = m * 0x1p-1
        k += 1
    }

    // s = f / (2 + f), in double-double.
    immut f = m - 0x1p0
    mut sumHigh = float(0)
    mut sumLow = float(0)
    twoSum(0x1p1, f, mut sumHigh, mut sumLow)
    immut sHigh = f / sumHigh
    mut productHigh = float(0)
    mut productLow = float(0)
    twoProduct(sHigh, sumHigh, mut productHigh, mut productLow)
    immut sLow = (((f - productHigh) - productLow) - sHigh * sumLow) / sumHigh
    // s^2, and the odd powers of s to s^9, in double-double.
    mut squareHigh = float(0)
    mut squareLow = float(0)
    doubleProduct(sHigh, sLow, sHigh, sLow, mut squareHigh, mut squareLow)
    mut cubeHigh = float(0)
    mut cubeLow = float(0)
    doubleProduct(sHigh, sLow, squareHigh, squareLow, mut cubeHigh, mut cubeLow)
    mut fifthHigh = float(0)
    mut fifthLow = float(0)
    doubleProduct(cubeHigh, cubeLow, squareHigh, squareLow, mut fifthHigh, mut fifthLow)
    mut seventhHigh = float(0)
    mut seventhLow = float(0)
    doubleProduct(fifthHigh, fifthLow, squareHigh, squareLow, mut seventhHigh, mut seventhLow)
    mut ninthHigh = float(0)
    mut ninthLow = float(0)
    doubleProduct(seventhHigh, seventhLow, squareHigh, squareLow, mut ninthHigh, mut ninthLow)
    // The rest, s^11 (2/11 + 2/13 s^2 + ... + 2/29 s^18), in double: below 2^-28 of the sum, so
    // its rounding is below 2^-80 of it.
    immut z = squareHigh
    immut series = 0x1.745d1745d1746p-3 + z * (0x1.3b13b13b13b14p-3 + z * (0x1.1111111111111p-3 + z * (0x1.e1e1e1e1e1e1ep-4 + z * (0x1.af286bca1af28p-4 + z * (0x1.8618618618618p-4 + z * (0x1.642c8590b2164p-4 + z * (0x1.47ae147ae147bp-4 + z * (0x1.2f684bda12f68p-4 + z * 0x1.1a7b9611a7b96p-4))))))))
    immut rest = ninthHigh * squareHigh * series
    mut termHigh = float(0)
    mut termLow = float(0)
    mut totalHigh = float(0)
    mut totalLow = float(0)
    // 2/9 s^9 + 2/7 s^7 + 2/5 s^5 + 2/3 s^3 + 2s, from the smallest term.
    doubleProduct(0x1.c71c71c71c71cp-3, 0x1.c71c71c71c71cp-57, ninthHigh, ninthLow, mut termHigh, mut termLow)
    doubleSum(termHigh, termLow, rest, float(0), mut totalHigh, mut totalLow)
    doubleProduct(0x1.2492492492492p-2, 0x1.2492492492492p-56, seventhHigh, seventhLow, mut termHigh, mut termLow)
    doubleSum(termHigh, termLow, totalHigh, totalLow, mut totalHigh, mut totalLow)
    doubleProduct(0x1.999999999999ap-2, -0x1.999999999999ap-56, fifthHigh, fifthLow, mut termHigh, mut termLow)
    doubleSum(termHigh, termLow, totalHigh, totalLow, mut totalHigh, mut totalLow)
    doubleProduct(0x1.5555555555555p-1, 0x1.5555555555555p-55, cubeHigh, cubeLow, mut termHigh, mut termLow)
    doubleSum(termHigh, termLow, totalHigh, totalLow, mut totalHigh, mut totalLow)
    doubleSum(0x1p1 * sHigh, 0x1p1 * sLow, totalHigh, totalLow, mut totalHigh, mut totalLow)
    // Plus k log 2: k ln2Hi is exact (ln2Hi has 32 bits).
    immut dk = float(k)
    doubleSum(dk * 0x1.62e42feep-1, dk * 0x1.a39ef35793c76p-33, totalHigh, totalLow, mut high, mut low)
}

// Double-double arithmetic: a number as high + low, |low| at most half an ulp of high.

// a + b exactly, as high + low (Knuth's two-sum).
function twoSum(a: float, b: float, mut high: float, mut low: float) {
    immut sum = a + b
    immut part = sum - a
    low = (a - (sum - part)) + (b - part)
    high = sum
}

// a * b as high + low, within 2^-104 of it (Dekker's product, without a fused multiply-add): each
// split in its high 26 bits and the 27 others, all the partial products exact but the last.
function twoProduct(a: float, b: float, mut high: float, mut low: float) {
    immut product = a * b
    immut aHigh = floatOfBits(floatBits(a) & -0x8000000)
    immut aLow = a - aHigh
    immut bHigh = floatOfBits(floatBits(b) & -0x8000000)
    immut bLow = b - bHigh
    low = ((aHigh * bHigh - product) + aHigh * bLow + aLow * bHigh) + aLow * bLow
    high = product
}

function doubleSum(aHigh: float, aLow: float, bHigh: float, bLow: float, mut high: float, mut low: float) {
    mut sum = float(0)
    mut error = float(0)
    twoSum(aHigh, bHigh, mut sum, mut error)
    error += aLow + bLow
    high = sum + error
    low = error - (high - sum)
}

function doubleProduct(aHigh: float, aLow: float, bHigh: float, bLow: float, mut high: float, mut low: float) {
    immut product = aHigh * bHigh
    immut aTop = floatOfBits(floatBits(aHigh) & -0x8000000)
    immut aRest = aHigh - aTop
    immut bTop = floatOfBits(floatBits(bHigh) & -0x8000000)
    immut bRest = bHigh - bTop
    immut error = ((aTop * bTop - product) + aTop * bRest + aRest * bTop) + aRest * bRest + (aHigh * bLow + aLow * bHigh)
    high = product + error
    low = error - (high - product)
}

// fdlibm's power, within 1 ulp, and in `tail` where it is between two floats (what its last
// rounding left out, in ulps; 0.5 when that is not measured).
function nearlyPower(x: float, y: float, mut tail: float): float {
    immut hx = high(x)
    immut lx = low(x)
    immut hy = high(y)
    immut ly = low(y)
    mut ix = hx & 0x7FFFFFFF
    immut iy = hy & 0x7FFFFFFF

    // x^0 is 1.
    if ((iy | ly) == 0) { return 0x1p0 }

    // Whether y is an integer, odd (1) or even (2), when x < 0.
    mut yisint = 0

    if (hx < 0) {
        if (iy >= 0x43400000) {
            yisint = 2
        } else {
            if (iy >= 0x3FF00000) {
                immut k = (iy >> 20) - 0x3FF

                if (k > 20) {
                    immut j = ly >> (52 - k)

                    if ((j << (52 - k)) == ly) { yisint = 2 - (j & 1) }
                } else {
                    if (ly == 0) {
                        immut j = iy >> (20 - k)

                        if ((j << (20 - k)) == iy) { yisint = 2 - (j & 1) }
                    }
                }
            }
        }
    }

    immut ax = koji_float_abs(x)

    // y is +-1, 2 or 0.5 (but where the result would be beyond the floats).
    if (ly == 0) {
        if (iy == 0x3FF00000) {
            if (hy >= 0) { return x }

            if (ax >= 0x0.8p-1022) { return 0x1p0 / x }
        }

        if (hy == 0x40000000 and ax < 0x1p511) { return x * x }

        if (hy == 0x3FE00000 and hx >= 0) { return koji_float_sqrt(x) }
    }

    // x is +-0 or +-1.
    if (lx == 0 and (ix == 0 or ix == 0x3FF00000)) {
        if (ix == 0) {
            // 0 to a negative power is left out by the callers; to a positive one, 0.
            if (hy < 0) { return infinity(hx < 0 and yisint == 1) }

            return signedZero(hx < 0 and yisint == 1)
        }

        // (-1)^odd is -1.
        if (hx < 0 and yisint == 1) { return -0x1p0 }

        return 0x1p0
    }

    mut n = (hx >> 31) + 1
    // The sign of the result: -1 for a negative base to an odd power.
    immut negative = (n | (yisint - 1)) == 0
    immut s = if (negative) { -0x1p0 } else { 0x1p0 }
    mut t1 = float(0)
    mut t2 = float(0)

    // |y| > 2^31: beyond the floats, unless x is close to 1.
    if (iy > 0x41E00000) {
        if (iy > 0x43F00000) {
            if (ix <= 0x3FEFFFFF) { return if (hy < 0) { infinity(false) } else { float(0) } }

            if (ix >= 0x3FF00000) { return if (hy > 0) { infinity(false) } else { float(0) } }
        }

        if (ix < 0x3FEFFFFF) { return if (hy < 0) { infinity(negative) } else { signedZero(negative) } }

        if (ix > 0x3FF00000) { return if (hy > 0) { infinity(negative) } else { signedZero(negative) } }

        // |1 - x| <= 2^-20: log(x) by x - x^2/2 + x^3/3 - x^4/4.
        immut t = ax - 0x1p0
        immut w = (t * t) * (0x1p-1 - t * (0x1.5555555555555p-2 - t * 0x1p-2))
        immut u = 0x1.715476p0 * t
        immut v = t * 0x1.4ae0bf85ddf44p-26 - w * 0x1.71547652b82fep0
        t1 = withLow(u + v, 0)
        t2 = v - (t1 - u)
    } else {
        mut ax2 = ax
        n = 0

        // A subnormal, scaled up.
        if (ix < 0x00100000) {
            ax2 = ax2 * 0x1p53
            n -= 53
            ix = high(ax2)
        }

        n += (ix >> 20) - 0x3FF
        immut j = ix & 0x000FFFFF
        // The interval of x.
        ix = j | 0x3FF00000
        mut k = 0

        if (j > 0x3988E) {
            if (j < 0xBB67A) {
                k = 1
            } else {
                n += 1
                ix -= 0x00100000
            }
        }

        ax2 = withHigh(ax2, ix)
        immut bp = if (k == 1) { 0x1.8p0 } else { 0x1p0 }
        immut dpH = if (k == 1) { 0x1.2b8034p-1 } else { float(0) }
        immut dpL = if (k == 1) { 0x1.cfdeb43cfd006p-27 } else { float(0) }
        // ss = s_h + s_l = (x - 1) / (x + 1) or (x - 1.5) / (x + 1.5).
        immut u = ax2 - bp
        immut v = 0x1p0 / (ax2 + bp)
        immut ss = u * v
        immut sH = withLow(ss, 0)
        // t_h = ax + bp, its high part.
        immut tH = fromWords(((ix >> 1) | 0x20000000) + 0x00080000 + (k << 18), 0)
        immut tL = ax2 - (tH - bp)
        immut sL = v * ((u - sH * tH) - sH * tL)
        // log(ax).
        mut s2 = ss * ss
        mut r = s2 * s2 * (0x1.3333333333303p-1 + s2 * (0x1.b6db6db6fabffp-2 + s2 * (0x1.55555518f264dp-2 + s2 * (0x1.17460a91d4101p-2 + s2 * (0x1.d864a93c9db65p-3 + s2 * 0x1.a7e284a454eefp-3)))))
        r += sL * (sH + ss)
        s2 = sH * sH
        immut tH2 = withLow(0x1.8p1 + s2 + r, 0)
        immut tL2 = r - ((tH2 - 0x1.8p1) - s2)
        // u + v = ss * (1 + ...).
        immut u2 = sH * tH2
        immut v2 = sL * tH2 + tL2 * ss
        // 2 / (3 log 2) * (ss + ...).
        immut pH = withLow(u2 + v2, 0)
        immut pL = v2 - (pH - u2)
        immut zH = 0x1.ec709ep-1 * pH
        immut zL = -0x1.e2fe0145b01f5p-28 * pH + pL * 0x1.ec709dc3a03fdp-1 + dpL
        // log2(ax) = (ss + ...) * 2 / (3 log 2) = n + dp_h + z_h + z_l.
        immut t = float(n)
        t1 = withLow(((zH + zL) + dpH) + t, 0)
        t2 = zL - (((t1 - t) - dpH) - zH)
    }

    // y split as y1 + y2, and (y1 + y2) * (t1 + t2).
    immut y1 = withLow(y, 0)
    mut pL = (y - y1) * t1 + y * t2
    mut pH = y1 * t1
    mut z = pL + pH
    mut j = high(z)
    immut i = low(z)

    // z >= 1024: beyond the floats; z <= -1075: 0.
    if (j >= 0x40900000) {
        if (((j - 0x40900000) | i) != 0) { return infinity(negative) }

        if (pL + 0x1.71547652b82fep-54 > z - pH) { return infinity(negative) }
    } else {
        if ((j & 0x7FFFFFFF) >= 0x4090CC00) {
            if ((((j & 0xFFFFFFFF) - 0xC090CC00) | i) != 0) { return signedZero(negative) }

            if (pL <= z - pH) { return signedZero(negative) }
        }
    }

    // 2^(p_h + p_l).
    immut magnitude = j & 0x7FFFFFFF
    mut k = (magnitude >> 20) - 0x3FF
    n = 0

    // |z| > 0.5: n = [z + 0.5].
    if (magnitude > 0x3FE00000) {
        n = j + (0x00100000 >> (k + 1))
        k = ((n & 0x7FFFFFFF) >> 20) - 0x3FF
        immut t = fromWords(n & ~(0x000FFFFF >> k), 0)
        n = ((n & 0x000FFFFF) | 0x00100000) >> (20 - k)

        if (j < 0) { n = -n }

        pH -= t
    }

    immut t = withLow(pL + pH, 0)
    immut u = t * 0x1.62e43p-1
    immut v = (pL - (t - pH)) * 0x1.62e42fefa39efp-1 + t * -0x1.05c610ca86c39p-29
    z = u + v
    immut w = v - (z - u)
    immut tt = z * z
    t1 = z - tt * (0x1.555555555553ep-3 + tt * (-0x1.6c16c16bebd93p-9 + tt * (0x1.1566aaf25de2cp-14 + tt * (-0x1.bbd41c5d26bf1p-20 + tt * 0x1.6376972bea4dp-25))))
    immut r = (z * t1) / (t1 - 0x1p1) - (w + z * w)
    // z = 1 - (r - z), and what its two roundings leave out, exactly: where the result is between
    // two floats, in ulps.
    mut difference = float(0)
    mut differenceRest = float(0)
    twoSum(r, -z, mut difference, mut differenceRest)
    mut rest = float(0)
    twoSum(0x1p0, -difference, mut z, mut rest)
    rest -= differenceRest
    immut bits = floatBits(z)
    // Below a power of 2 the ulp is half: not measured.
    tail = if ((bits & 0xFFFFFFFFFFFFF) == 0) { 0x1p-1 } else { rest / floatOfBits((bits & 0x7FF0000000000000) - (52 << 52)) }
    j = high(z) + (n << 20)

    // A subnormal result: scaled down in two steps, the second one rounding once.
    if ((j >> 20) <= 0) {
        tail = 0x1p-1
        return s * (z * powerOfTwo(n + 1022)) * powerOfTwo(-1022)
    }

    return s * withHigh(z, j)
}

// 2^n, for n from -1022 to 1023.
function powerOfTwo(n: int): float {
    return floatOfBits((n + 1023) << 52)
}

// The float of a decimal text (`strtod`)

// The float nearest to the number written from `text` for `size` bytes, as Koji and C write
// numbers: a sign, digits with a point, an exponent (`-12.5e-3`). An infinity when it is beyond
// the floats. Exact: the digits as a big integer, times or divided by the power of 10.
extern function koji_float_parse(text: Address, size: int): float {
    mut at = 0
    mut negative = false
    mut digits: int[] = []
    mut exponent = 0

    if (at < size and (byteAt(text, at) == 45 or byteAt(text, at) == 43)) {
        negative = byteAt(text, at) == 45
        at += 1
    }

    while (at < size and isDigit(byteAt(text, at))) {
        addDigit(byteAt(text, at) - 48, mut digits)
        at += 1
    }

    if (at < size and byteAt(text, at) == 46) {
        at += 1

        while (at < size and isDigit(byteAt(text, at))) {
            addDigit(byteAt(text, at) - 48, mut digits)
            exponent -= 1

            at += 1
        }
    }

    if (at < size and (byteAt(text, at) == 101 or byteAt(text, at) == 69)) {
        at += 1
        mut negativePower = false

        if (at < size and (byteAt(text, at) == 45 or byteAt(text, at) == 43)) {
            negativePower = byteAt(text, at) == 45
            at += 1
        }

        mut power = 0

        while (at < size and isDigit(byteAt(text, at))) {
            if (power < 100000) { power = power * 10 + byteAt(text, at) - 48 }

            at += 1
        }

        exponent += if (negativePower) { -power } else { power }
    }

    return nearestOfDecimal(digits, exponent, negative)
}

function byteAt(text: Address, at: int): int {
    immut b: byte = read(text, at)
    return int(b)
}

function isDigit(b: int): boolean {
    return b >= 48 and b <= 57
}

// Adds a digit to the significant ones: none before the first that is not 0.
function addDigit(digit: int, mut digits: int[]) {
    if (digits.length() == 0 and digit == 0) { return }

    digits.push(digit)
}

// The most digits kept: more than the 767 that a float can need to be told from its neighbors; a
// digit 1 after them stands for those left out, when one of them is not 0.
immut keptDigits = 800

// The float nearest to `digits` (decimal, the first not 0) times 10^`exponent`.
function nearestOfDecimal(given: int[], givenExponent: int, negative: boolean): float {
    mut digits = given
    mut exponent = givenExponent

    // The zeros at the end: a power of 10.
    while (digits.length() > 0 and digits[digits.length() - 1] == 0) {
        digits.pop()
        exponent += 1
    }

    if (digits.length() == 0) { return signedZero(negative) }

    if (digits.length() > keptDigits) {
        exponent += digits.length() - keptDigits
        digits = digits[0..keptDigits]
        digits.push(1)
        exponent -= 1
    }

    // Beyond the floats, or below half the smallest one.
    immut magnitude = digits.length() + exponent

    if (magnitude > 310) { return infinity(negative) }

    if (magnitude < -326) { return signedZero(negative) }

    immut number = bigOfDigits(digits)

    if (exponent >= 0) {
        immut product = bigTimesTenTo(number, exponent)
        return nearestOfBig(product, 0, false, negative)
    }

    // number / 10^-exponent: a quotient of some 66 bits, from the number or the divisor shifted to
    // the left.
    immut shift = bitLength(bigTimesTenTo([1], -exponent)) - bitLength(number) + 66
    immut divisor = shiftLeft(bigTimesTenTo([1], -exponent), if (shift < 0) { -shift } else { 0 })
    mut rest = shiftLeft(number, if (shift > 0) { shift } else { 0 })
    mut quotient: U128 = 0
    mut place = bitLength(rest) - bitLength(divisor)

    while (place >= 0) {
        immut part = shiftLeft(divisor, place)

        if (compare(rest, part) >= 0) {
            rest = subtract(rest, part)
            immut one: U128 = 1
            quotient = quotient | (one << wide(place, 0))
        }

        place -= 1
    }

    return nearest(quotient, -shift, not isZero(rest), negative)
}

// The nearest float to a big integer times 2^`exponent`: its top 64 bits, the others as sticky.
function nearestOfBig(n: int[], exponent: int, sticky: boolean, negative: boolean): float {
    immut length = bitLength(n)

    if (length <= 64) { return nearest(topBits(n, 0), exponent, sticky, negative) }

    immut dropped = length - 64
    return nearest(topBits(n, dropped), exponent + dropped, sticky or lowBitsSet(n, dropped), negative)
}

// Big integers: limbs of 32 bits, the lowest first, none 0 at the end.

function bigOfDigits(digits: int[]): int[] {
    mut n: int[] = []
    mut at = 0

    while (at < digits.length()) {
        mut chunk = 0
        mut factor = 1
        mut count = 0

        while (count < 9 and at < digits.length()) {
            chunk = chunk * 10 + digits[at]
            factor *= 10
            count += 1
            at += 1
        }

        multiplyAdd(mut n, factor, chunk)
    }

    return n
}

// n * factor + addend, in place (factor and addend below 2^31).
function multiplyAdd(mut n: int[], factor: int, addend: int) {
    mut carry = addend

    for i in range(n.length()) {
        immut t = n[i] * factor + carry
        n[i] = t & 0xFFFFFFFF
        carry = t >> 32
    }

    while (carry != 0) {
        n.push(carry & 0xFFFFFFFF)
        carry = carry >> 32
    }
}

function bigTimesTenTo(given: int[], power: int): int[] {
    mut n = given
    mut left = power

    while (left >= 9) {
        multiplyAdd(mut n, 1000000000, 0)
        left -= 9
    }

    mut factor = 1

    for _ in range(left) {
        factor *= 10
    }

    if (factor > 1) { multiplyAdd(mut n, factor, 0) }

    return n
}

function bitLength(n: int[]): int {
    if (n.length() == 0) { return 0 }

    immut top = n[n.length() - 1]
    return (n.length() - 1) * 32 + 128 - leadingZeros(wide(top, 0))
}

function shiftLeft(n: int[], bits: int): int[] {
    if (n.length() == 0) { return [] }

    immut limbs = bits / 32
    immut rest = bits % 32
    mut out: int[] = []

    for _ in range(limbs) {
        out.push(0)
    }

    mut carry = 0

    for limb in n {
        immut shifted = (limb << rest) | carry
        out.push(shifted & 0xFFFFFFFF)
        carry = shifted >> 32
    }

    if (carry != 0) { out.push(carry) }

    return out
}

function compare(a: int[], b: int[]): int {
    if (a.length() != b.length()) { return if (a.length() < b.length()) { -1 } else { 1 } }

    for i in range(a.length() - 1, -1, -1) {
        if (a[i] != b[i]) { return if (a[i] < b[i]) { -1 } else { 1 } }
    }

    return 0
}

// a - b, for a >= b.
function subtract(a: int[], b: int[]): int[] {
    mut out: int[] = []
    mut borrow = 0

    for i in range(a.length()) {
        mut t = a[i] - borrow - (if (i < b.length()) { b[i] } else { 0 })
        borrow = 0

        if (t < 0) {
            t += 0x100000000
            borrow = 1
        }

        out.push(t)
    }

    while (out.length() > 0 and out[out.length() - 1] == 0) {
        out.pop()
    }

    return out
}

function isZero(n: int[]): boolean {
    return n.length() == 0
}

// The bits of n from `start` up (at most 64 of them), as a U128.
function topBits(n: int[], start: int): U128 {
    mut value: U128 = 0
    immut limbs = start / 32
    immut rest = start % 32

    for i in range(n.length() - 1, limbs - 1, -1) {
        value = (value << 32) | wide(n[i], 0)
    }

    return value >> wide(rest, 0)
}

// Whether a bit of n below `count` is 1.
function lowBitsSet(n: int[], count: int): boolean {
    immut limbs = count / 32

    for i in range(limbs) {
        if (i < n.length() and n[i] != 0) { return true }
    }

    immut rest = count % 32

    if (rest == 0 or limbs >= n.length()) { return false }

    return (n[limbs] & ((1 << rest) - 1)) != 0
}
