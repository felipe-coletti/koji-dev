// The functions of floats that the C library gave (its `libm` and `strtod`), written in Koji, each
// giving the float nearest to the exact result, always: the rounding to integers, the absolute
// value and the remainder, exact, from the bits; the square root, by the instruction of the
// processor; the logarithms and the power, in double-double with proven bounds when that
// decides, in fixed point with big integers, as many bits as it takes, when it does not; and the
// float of a decimal text, from the digits as a big integer.

import { Address, U128, floatBits, floatOfBits, floatSqrt, leadingZeros, lowWord, read, stringBytes, truncate, wide } from 'koji:unsafe'
import { inversePowersOfFive, powersOfFive } from 'koji:ryu'

// The high 32 bits of a float, signed, and its low 32 bits (fdlibm's __HI and __LO).
function high(x: float): int {
    return floatBits(x) >> 32
}

function low(x: float): int {
    return floatBits(x) & 0xFFFFFFFF
}

// A float of these high and low words.
function fromWords(hi: int, lo: int): float {
    return floatOfBits((hi << 32) | (lo & 0xFFFFFFFF))
}

function withHigh(x: float, hi: int): float {
    return fromWords(hi, low(x))
}

function withLow(x: float, lo: int): float {
    return fromWords(high(x), lo)
}

// Infinity and zero with a sign: the results beyond the floats, which the callers check (an
// operation of Koji that gives an infinity panics; these are made from their bits).
function infinity(negative: boolean): float {
    return floatOfBits(0x7FF0000000000000 | signOf(negative))
}

function signedZero(negative: boolean): float {
    return floatOfBits(signOf(negative))
}

// The sign bit of a float, set when `negative`.
function signOf(negative: boolean): int {
    return if (negative) { -9223372036854775807 - 1 } else { 0 }
}

// Rounding to integers

// The integer part of `x`, with its sign (`trunc(-0.5)` is -0).
extern function koji_float_trunc(x: float): float {
    immut bits = floatBits(x)
    immut exponent = ((bits >> 52) & 0x7FF) - 1023

    if (exponent < 0) { return floatOfBits(bits & (-9223372036854775807 - 1)) }

    if (exponent >= 52) { return x }

    immut fraction = (1 << (52 - exponent)) - 1
    return floatOfBits(bits & ~fraction)
}

extern function koji_float_floor(x: float): float {
    immut whole = koji_float_trunc(x)
    return if (x < whole) { whole - 0x1p0 } else { whole }
}

extern function koji_float_ceil(x: float): float {
    immut whole = koji_float_trunc(x)
    return if (x > whole) { whole + 0x1p0 } else { whole }
}

// The nearest integer, halfway cases away from zero (`round(2.5)` is 3, `round(-2.5)` is -3).
extern function koji_float_round(x: float): float {
    immut whole = koji_float_trunc(x)
    // Exact: `x` and its integer part are in the same binade or next to it.
    immut rest = x - whole

    if (rest >= 0x1p-1) { return whole + 0x1p0 }

    if (rest <= -0x1p-1) { return whole - 0x1p0 }

    return whole
}

extern function koji_float_abs(x: float): float {
    return floatOfBits(floatBits(x) & 0x7FFFFFFFFFFFFFFF)
}

// The remainder of `x` divided by `y` (not 0), with the sign of `x`, as `%` gives it (C's `fmod`):
// exact, from the mantissas as integers, the power of 2 between them taken 10 bits at a time.
extern function koji_float_remainder(x: float, y: float): float {
    immut negative = x < float(0) or (x == float(0) and floatBits(x) < 0)

    if (koji_float_abs(x) < koji_float_abs(y)) { return x }

    immut dividend = floatBits(x)
    immut divisor = floatBits(y)
    immut divisorMantissa = mantissaOf(divisor)
    mut rest = mantissaOf(dividend) % divisorMantissa
    mut gap = exponentOf(dividend) - exponentOf(divisor)

    while (gap > 0) {
        immut step = if (gap < 10) { gap } else { 10 }
        rest = (rest << step) % divisorMantissa
        gap -= step
    }

    return nearest(wide(rest, 0), exponentOf(divisor), false, negative)
}

// The mantissa of a float as an integer, and its power of 2: the float is mantissa * 2^exponent.
function mantissaOf(bits: int): int {
    immut fraction = bits & 0xFFFFFFFFFFFFF
    return if (((bits >> 52) & 0x7FF) == 0) { fraction } else { fraction | (1 << 52) }
}

function exponentOf(bits: int): int {
    immut field = (bits >> 52) & 0x7FF
    return if (field == 0) { -1074 } else { field - 1075 }
}

// The nearest float to `mantissa` times 2^`exponent` (`sticky`: something not zero below the bits
// of `mantissa`), rounded half to even, as a subnormal float or an infinity when it is one.
function nearest(mantissa: U128, exponent: int, sticky: boolean, negative: boolean): float {
    if (mantissa == 0) { return signedZero(negative) }

    immut length = 128 - leadingZeros(mantissa)
    immut magnitude = length - 1 + exponent

    if (magnitude > 1023) { return infinity(negative) }

    // The bits a float keeps of it: 53, fewer for a subnormal.
    immut precision = if (magnitude < -1022) { 53 - (-1022 - magnitude) } else { 53 }

    if (precision < 0) { return signedZero(negative) }

    immut shift = length - precision
    mut kept: U128 = 0
    mut scale = exponent

    if (shift <= 0) {
        kept = mantissa << wide(-shift, 0)
        scale += shift
    } else {
        kept = mantissa >> wide(shift, 0)
        immut one: U128 = 1
        immut rest = mantissa & ((one << wide(shift, 0)) - 1)
        immut half = one << wide(shift - 1, 0)

        if (rest > half or (rest == half and (sticky or (kept & 1) == 1))) { kept += 1 }

        scale += shift
    }

    immut top: U128 = 1
    immut limit = top << 53

    if (kept == limit) {
        kept = kept >> 1
        scale += 1
    }

    immut q = lowWord(kept)
    immut sign = signOf(negative)

    // A subnormal: the bits of the mantissa alone.
    if (q < (1 << 52)) { return floatOfBits(sign | q) }

    immut biased = scale + 52 + 1023

    if (biased >= 2047) { return infinity(negative) }

    return floatOfBits(sign | (biased << 52) | (q & 0xFFFFFFFFFFFFF))
}

// The square root of `x` (0 or more), correctly rounded: the instruction of the processor, which
// IEEE 754 asks to round correctly (sqrtsd, fsqrt).
extern function koji_float_sqrt(x: float): float {
    return floatSqrt(x)
}

// The integer square root of `n`, rounded down (bit by bit).
function integerRoot(n: U128): U128 {
    mut rest = n
    mut root: U128 = 0
    mut bit: U128 = 1
    bit = bit << 126

    while (bit > rest) {
        bit = bit >> 2
    }

    while (bit != 0) {
        if (rest >= root + bit) {
            rest -= root + bit
            root = (root >> 1) + bit
        } else {
            root = root >> 1
        }

        bit = bit >> 2
    }

    return root
}

// Logarithms and powers, correctly rounded always (Ziv's way)
//
// First in double-double, with a bound on the error proven step by step (`logTwo`,
// `checkedPower`): the result when every number within it rounds to the same float. Otherwise, a
// result is computed in fixed point, with big integers of `bits` bits after the point, and a
// bound on its error that each step adds its own to (a rounding down, the error of what it was
// given). The float it gives is the one that every number within that bound rounds to; when the
// bound leaves two floats possible, the result is computed again with twice the bits. That ends
// for any result but one exactly in the middle of two floats, which no approximation tells from
// its neighbors: x^y can be one (`exactPower` computes it exactly), a logarithm cannot (the
// logarithm of a rational number other than 1, and of 10 for log10, is irrational).

// A number in fixed point: magnitude * 2^-bits, with its sign, and the most it may be off by, in
// units of 2^-bits (a float, rounded up: it can be beyond the ints).
type Fixed = {
    negative: boolean
    magnitude: int[]
    error: float
}

// The natural logarithm of `x` (more than 0).
extern function koji_float_log(x: float): float {
    if (x == float(0)) { return infinity(true) }

    if (x == 0x1p0) { return float(0) }

    // In double-double first: decided there but within 2^-60 or so of the middle of two floats.
    mut high = float(0)
    mut low = float(0)
    mut error = float(0)
    logTwo(x, mut high, mut low, mut error)
    mut fast = float(0)

    if (nearestOf(high, low, error, mut fast)) { return fast }

    mut bits = 128

    while (bits < 65536) {
        mut result = float(0)

        if (decided(logarithm(x, bits), bits, 0, mut result)) { return result }

        bits *= 2
    }

    // Not reached: no logarithm is that close to the middle of two floats.
    immut log = logarithm(x, bits)
    return nearestOfBig(log.magnitude, -bits, false, log.negative)
}

// The logarithm in base 10 of `x` (more than 0): log x / log 10, exact for the powers of 10.
extern function koji_float_log10(x: float): float {
    if (x == float(0)) { return infinity(true) }

    // 10^0 to 10^22, the powers of 10 that are floats.
    mut power = 0x1p0

    for n in range(23) {
        if (x == power) { return float(n) }

        power = power * 0x1.4p3
    }

    // In double-double first: log x times 1 / ln 10 (within 2^-111 as two floats), the product
    // within 2^-100.
    mut high = float(0)
    mut low = float(0)
    mut error = float(0)
    logTwo(x, mut high, mut low, mut error)
    doubleProduct(high, low, 0x1.bcb7b1526e50ep-2, 0x1.95355baaafad3p-57, mut high, mut low)
    mut fast = float(0)

    if (nearestOf(high, low, upNumber(error * 0x1.bcb7b1526e50ep-2 + koji_float_abs(high) * 0x1p-99), mut fast)) { return fast }

    mut bits = 128
    mut quotient: int[] = []
    mut negative = false

    while (bits <= 65536) {
        immut log = logarithm(x, bits)
        immut ten = logOfTen(bits)
        // |log x| 2^bits / log 10: off by the error of log x, over log 10 (more than 2), and that of
        // log 10 times the quotient (at most 324), over log 10.
        quotient = divide(shiftLeft(log.magnitude, bits), ten.magnitude)
        negative = log.negative
        immut value: Fixed = { negative: negative, magnitude: quotient, error: up(log.error + ten.error * 0x1.2cp7 + 0x1p1) }
        mut result = float(0)

        if (decided(value, bits, 0, mut result)) { return result }

        bits *= 2
    }

    // Not reached: no such logarithm is that close to the middle of two floats.
    return nearestOfBig(quotient, -bits / 2, false, negative)
}

// `base` to the power `exponent`, in the real numbers: the callers leave out a negative base with
// an exponent that is not an integer, and 0 to a negative power. An infinity, or 0, when the
// result is beyond the floats.
extern function koji_float_power(x: float, y: float): float {
    // Exact as IEEE 754 operations, rounded once.
    if (y == float(0) or x == 0x1p0) { return 0x1p0 }

    if (y == 0x1p0) { return x }

    if (y == 0x1p1 and koji_float_abs(x) < 0x1p511) { return x * x }

    if (y == 0x1p-1 and x > float(0)) { return koji_float_sqrt(x) }

    if (y == -0x1p0 and koji_float_abs(x) > 0x1p-1024) { return 0x1p0 / x }

    // The sign: a negative base to an odd power.
    immut odd = isOddInteger(y)
    immut negative = floatBits(x) < 0 and odd

    if (x == float(0)) { return if (y > float(0)) { signedZero(negative) } else { infinity(negative) } }

    immut magnitude = koji_float_abs(x)

    // (-1)^y, y an integer.
    if (magnitude == 0x1p0) { return if (negative) { -0x1p0 } else { 0x1p0 } }

    // |y| at least 2^64, and |log x| at least 2^-53 (x is not 1): |y log x| is beyond 745, and the
    // result beyond the floats.
    if (koji_float_abs(y) >= 0x1p64) {
        return if ((magnitude > 0x1p0) == (y > float(0))) { infinity(negative) } else { signedZero(negative) }
    }

    // The fast phase: fdlibm's result checked, then the slow one when that does not decide.
    mut fast = float(0)

    if (checkedPower(magnitude, y, mut fast)) { return if (negative) { -fast } else { fast } }

    mut bits = 128

    while (bits <= 65536) {
        immut exponent = times(logarithm(magnitude, bits), y)
        // e^t beyond 2^1024 (t above 709.79), or below 2^-1076, which rounds to 0 (t below -745.83).
        immut least = nearestOfBig(subtractError(exponent.magnitude, exponent.error), -bits, false, false)

        if (exponent.negative and least >= 0x1.75p9) { return signedZero(negative) }

        if (not exponent.negative and least >= 0x1.63p9) { return infinity(negative) }

        mut scale = 0
        immut power = exponential(exponent, bits, mut scale)
        immut signed: Fixed = { negative: negative, magnitude: power.magnitude, error: power.error }
        mut result = float(0)

        if (decided(signed, bits, scale, mut result)) { return result }

        // Undecided with this many bits: it may be exactly the middle of two floats.
        if (bits == 2048) {
            match (exactPower(magnitude, y)) {
                Some(found) => return if (negative) { -found } else { found }
                None => {}
            }
        }

        bits *= 2
    }

    // Not reached: a result that is not the middle of two floats is decided with fewer bits.
    mut scale = 0
    immut power = exponential(times(logarithm(magnitude, bits), y), bits, mut scale)
    return nearestOfBig(power.magnitude, scale - bits, false, negative)
}

// Whether every number within the error of `value` (times 2^`scale`) rounds to the same float,
// and that float in `result`.
function decided(value: Fixed, bits: int, scale: int, mut result: float): boolean {
    immut low = nearestOfBig(subtractError(value.magnitude, value.error), scale - bits, false, value.negative)
    immut high = nearestOfBig(add(value.magnitude, bigOfError(value.error)), scale - bits, false, value.negative)

    if (floatBits(low) != floatBits(high)) { return false }

    result = low
    return true
}

// The magnitude less the error (0 when the error is larger).
function subtractError(magnitude: int[], error: float): int[] {
    immut amount = bigOfError(error)
    return if (compare(magnitude, amount) > 0) { subtract(magnitude, amount) } else { [] }
}

// An error bound, a float, as a big integer at least as large.
function bigOfError(error: float): int[] {
    immut whole = koji_float_ceil(error)
    immut bits = floatBits(whole)

    if (whole == float(0)) { return [] }

    immut exponent = exponentOf(bits)
    immut mantissa = bigOfInt(mantissaOf(bits))
    return if (exponent >= 0) { shiftLeft(mantissa, exponent) } else { shiftRight(mantissa, -exponent) }
}

// A bound a little larger than `x` (by 2^-40 of it, more than the roundings of the few operations
// of floats that gave it), for errors in units of 2^-bits.
function up(x: float): float {
    return x * 0x1.0000000001p0 + 0x1p-30
}

// The same for an error that is a number, however small (by the least subnormal too).
function upNumber(x: float): float {
    return x * 0x1.0000000001p0 + 0x1p-1074
}

// Whether every number from high + low - error to high + low + error rounds to `high` (the float
// nearest to high + low, which double-double keeps), and then `high` in `result`: low and its
// error inside half the gap to each neighbor of high (differences of floats next to each other
// are exact, and so are their halves here).
function nearestOf(high: float, low: float, error: float, mut result: float): boolean {
    immut bits = floatBits(high)
    immut above = floatOfBits(if (high > float(0)) { bits + 1 } else { bits - 1 })
    immut below = floatOfBits(if (high > float(0)) { bits - 1 } else { bits + 1 })

    if (koji_float_abs(above) > 0x1.fffffffffffffp1023 or koji_float_abs(below) > 0x1.fffffffffffffp1023) { return false }

    if (low - error <= (below - high) * 0x1p-1 or low + error >= (above - high) * 0x1p-1) { return false }

    result = high
    return true
}

// |x|^y (x more than 0, |y| below 2^64) by fdlibm, checked: when it is a normal float r, the
// exact power is r e^d, d = y log x - log r, which double-double gives within a bound (logTwo's,
// times |y| for log x); r e^d - r, in units of the ulp of r, is M (e^d - 1), M the mantissa of r
// as an integer. The power is r, or the float above or below it, when all of that interval is
// nearer to it than to the others.
function checkedPower(x: float, y: float, mut result: float): boolean {
    immut r = koji_float_abs(nearlyPower(x, y))

    if (r < 0x1p-1022 or r >= 0x1.fffffffffffffp1023) { return false }

    mut xHigh = float(0)
    mut xLow = float(0)
    mut xError = float(0)
    logTwo(x, mut xHigh, mut xLow, mut xError)
    mut rHigh = float(0)
    mut rLow = float(0)
    mut rError = float(0)
    logTwo(r, mut rHigh, mut rLow, mut rError)
    // y log x: the product of the high parts within 2^-101, y xLow within u of itself.
    mut wantedHigh = float(0)
    mut wantedLow = float(0)
    twoProduct(y, xHigh, mut wantedHigh, mut wantedLow)
    immut lowPart = y * xLow
    immut highDifference = wantedHigh - rHigh
    immut lowDifference = (wantedLow + lowPart) - rLow
    immut d = highDifference + lowDifference
    // Each operation of floats above within u (2^-52 here, for room) of its result.
    immut dError = upNumber(koji_float_abs(y) * xError + rError + koji_float_abs(wantedHigh) * 0x1p-100 + (koji_float_abs(lowPart) + koji_float_abs(highDifference) + koji_float_abs(lowDifference) + koji_float_abs(wantedLow + lowPart) + koji_float_abs(d)) * 0x1p-52)

    // r far from the power: the slow phase.
    if (koji_float_abs(d) > 0x1p-40) { return false }

    // e^d - 1 = d + d^2 / 2 + ..., the rest below |d|^3; M at most 2^53, exact as a float.
    immut bits = floatBits(r)
    immut mantissa = float(mantissaOf(bits))
    immut grown = d + d * d * 0x1p-1
    immut place = mantissa * grown
    immut placeError = upNumber(mantissa * (dError * 0x1.0000000001p0 + koji_float_abs(d * d * d) + koji_float_abs(grown) * 0x1p-52) + koji_float_abs(place) * 0x1p-52)
    // The neighbors of r, and theirs, in units of the ulp of r (exact: powers of 2 apart).
    immut ulp = floatOfBits(bits + 1) - r
    immut above = (floatOfBits(bits + 1) - r) / ulp
    immut aboveNext = (floatOfBits(bits + 2) - floatOfBits(bits + 1)) / ulp
    immut below = (r - floatOfBits(bits - 1)) / ulp
    immut belowNext = (floatOfBits(bits - 1) - floatOfBits(bits - 2)) / ulp
    immut least = place - placeError
    immut most = place + placeError

    if (least > -below * 0x1p-1 and most < above * 0x1p-1) {
        result = r
        return true
    }

    if (least > above * 0x1p-1 and most < above + aboveNext * 0x1p-1 and floatOfBits(bits + 1) <= 0x1.fffffffffffffp1023) {
        result = floatOfBits(bits + 1)
        return true
    }

    if (most < -below * 0x1p-1 and least > -below - belowNext * 0x1p-1 and r > 0x1p-1022) {
        result = floatOfBits(bits - 1)
        return true
    }

    return false
}

// log x (x a float more than 0) = k log 2 + log m, x = 2^k m with m from sqrt(2) / 2 to sqrt(2);
// log m = 2 atanh((m - 1) / (m + 1)), with m - 1 and m + 1 exact integers (m = M / 2^d).
function logarithm(x: float, bits: int): Fixed {
    immut xBits = floatBits(x)
    immut mantissa = mantissaOf(xBits)
    immut length = intBits(mantissa)
    mut denominator = length - 1
    mut k = exponentOf(xBits) + length - 1
    immut whole = bigOfInt(mantissa)

    // m above sqrt(2): M^2 above 2 * 2^(2d), then m / 2.
    if (compare(multiply(whole, whole), shiftLeft(bigOfInt(1), 2 * denominator + 1)) > 0) {
        denominator += 1
        k += 1
    }

    immut half = 1 << denominator
    immut below = mantissa < half
    immut difference = if (below) { half - mantissa } else { mantissa - half }
    immut s = divideByInt(shiftLeft(bigOfInt(difference), bits), mantissa + half)
    immut logM = atanhTwice(s, bits)

    if (k == 0) { return { negative: below, magnitude: logM.magnitude, error: logM.error } }

    immut two = logOfTwo(bits)
    immut count = if (k < 0) { -k } else { k }
    immut multiple = multiplySmall(two.magnitude, count)
    mut negative = false
    immut sum = signedSum(k < 0, multiple, below, logM.magnitude, mut negative)
    return { negative: negative, magnitude: sum, error: up(two.error * float(count) + logM.error) }
}

// 2 atanh(s) = 2 (s + s^3 / 3 + s^5 / 5 + ...), for s (in fixed point, rounded down, below 1/5).
// Each term is off by at most 3 units (1 from s, 1.4 from s^2, 1 from each rounding down), and
// those left out once a term is 0 add up to less than 1.
function atanhTwice(s: int[], bits: int): Fixed {
    immut square = shiftRight(multiply(s, s), bits)
    mut term = s
    mut sum = s
    mut k = 1

    while (not isZero(term)) {
        term = shiftRight(multiply(term, square), bits)
        sum = add(sum, divideSmall(term, 2 * k + 1))
        k += 1
    }

    return { negative: false, magnitude: shiftLeft(sum, 1), error: float(2 * (3 * k + 4)) }
}

// log 2 = 2 atanh(1/3), kept for the most bits it was computed with (a list of one: the library
// has one thread).
mut twoLogs: Fixed[] = []
mut twoLogBits: int[] = []

function logOfTwo(bits: int): Fixed {
    if (twoLogBits.length() == 0 or twoLogBits[0] < bits) {
        immut value = atanhTwice(divideSmall(shiftLeft(bigOfInt(1), bits), 3), bits)
        twoLogs = [value]
        twoLogBits = [bits]
        return value
    }

    // Fewer bits than kept: rounded down, one more unit off.
    immut drop = twoLogBits[0] - bits
    immut kept = twoLogs[0]
    return { negative: false, magnitude: shiftRight(kept.magnitude, drop), error: up(kept.error / powerOfTwo(drop) + 0x1p0) }
}

// 2^n as a float, for n from 0 up (an infinity beyond 1023, which a bound may be).
function powerOfTwo(n: int): float {
    return if (n > 1023) { infinity(false) } else { floatOfBits((n + 1023) << 52) }
}

// log 10 = 3 log 2 + log(5/4), and log(5/4) = 2 atanh(1/9).
function logOfTen(bits: int): Fixed {
    immut two = logOfTwo(bits)
    immut quarter = atanhTwice(divideSmall(shiftLeft(bigOfInt(1), bits), 9), bits)
    return { negative: false, magnitude: add(multiplySmall(two.magnitude, 3), quarter.magnitude), error: up(two.error * 0x1.8p1 + quarter.error) }
}

// t y, for y a float (|y| below 2^64): y = Y 2^F, Y an integer of 53 bits.
function times(t: Fixed, y: float): Fixed {
    immut yBits = floatBits(y)
    immut product = multiply(t.magnitude, bigOfInt(mantissaOf(yBits)))
    immut exponent = exponentOf(yBits)
    immut scaled = if (exponent >= 0) { shiftLeft(product, exponent) } else { shiftRight(product, -exponent) }
    // The error times |y|, and one unit of the rounding down.
    return { negative: t.negative != (y < float(0)), magnitude: scaled, error: up(t.error * koji_float_abs(y) + 0x1p0) }
}

// e^t = 2^k e^r, r = t - k log 2 from -log 2 / 2 to log 2 / 2: e^r (from 0.7 to 1.42, in fixed
// point), and k in `scale`. e^r = 1 + r + r^2 / 2 + ..., each term off by at most 3.1 units, and
// e^(r + d) = e^r e^d off by 1.5 |d| for the error d of r.
function exponential(t: Fixed, bits: int, mut scale: int): Fixed {
    immut two = logOfTwo(bits)
    // q = |t| / log 2 rounded down (at most 1077 here), from the floats of both, then exactly.
    mut q = truncate(koji_float_trunc(nearestOfBig(t.magnitude, -bits, false, false) * 0x1.71547652b82fep0))

    // Exactly: q log 2 at most |t|, (q + 1) log 2 more.
    while (q > 0 and compare(multiplySmall(two.magnitude, q), t.magnitude) > 0) {
        q -= 1
    }

    while (compare(multiplySmall(two.magnitude, q + 1), t.magnitude) <= 0) {
        q += 1
    }

    immut rest = subtract(t.magnitude, multiplySmall(two.magnitude, q))
    // The nearer multiple of log 2.
    immut far = compare(rest, shiftRight(two.magnitude, 1)) > 0
    immut k = if (far) { q + 1 } else { q }
    immut r = if (far) { subtract(two.magnitude, rest) } else { rest }
    // r is t - k log 2: with the sign of t, but the other one when k went past |t|.
    immut negativeR = t.negative != far
    immut errorR = up(t.error + two.error * float(k))
    scale = if (t.negative) { -k } else { k }
    immut one = shiftLeft(bigOfInt(1), bits)
    mut term = one
    mut positive = one
    mut negativeSum: int[] = []
    mut n = 1

    while (not isZero(term)) {
        term = divideSmall(shiftRight(multiply(term, r), bits), n)

        if (negativeR and n % 2 == 1) {
            negativeSum = add(negativeSum, term)
        } else {
            positive = add(positive, term)
        }

        n += 1
    }

    return { negative: false, magnitude: subtract(positive, negativeSum), error: up(errorR * 0x1.8p0 + float(4 * n + 2)) }
}

// a + b with their signs, in `negative` the sign of the sum.
function signedSum(aNegative: boolean, a: int[], bNegative: boolean, b: int[], mut negative: boolean): int[] {
    if (aNegative == bNegative) {
        negative = aNegative
        return add(a, b)
    }

    if (compare(a, b) >= 0) {
        negative = aNegative
        return subtract(a, b)
    }

    negative = bNegative
    return subtract(b, a)
}

// Whether `y` is an odd integer.
function isOddInteger(y: float): boolean {
    immut bits = floatBits(y)
    mut mantissa = mantissaOf(bits)
    mut exponent = exponentOf(bits)

    if (mantissa == 0) { return false }

    while (mantissa % 2 == 0) {
        mantissa = mantissa / 2
        exponent += 1
    }

    return exponent == 0
}

// x^y exactly, when it is a float or the middle of two floats (x more than 0). y = Y / 2^q, Y odd:
// x^(1/2^q) must then be a number of a few bits (x is M 2^E, M of at most 53 bits), found by q
// exact square roots; and x^Y with Y an integer is exact (a big integer times a power of 2), or,
// for a negative Y, a fraction that is a float or a middle only when x is a power of 2.
function exactPower(x: float, y: float): Option[float] {
    immut xBits = floatBits(x)
    mut base = mantissaOf(xBits)
    mut baseExponent = exponentOf(xBits)

    while (base % 2 == 0) {
        base = base / 2
        baseExponent += 1
    }

    immut yBits = floatBits(y)
    mut count = mantissaOf(yBits)
    mut countExponent = exponentOf(yBits)

    while (count % 2 == 0) {
        count = count / 2
        countExponent += 1
    }

    while (countExponent < 0) {
        if (baseExponent % 2 != 0) { return None }

        immut root = lowWord(integerRoot(wide(base, 0)))

        if (root * root != base) { return None }

        base = root
        baseExponent = baseExponent / 2
        countExponent += 1
    }

    // y an integer now: count 2^countExponent.
    if (base == 1) {
        if (countExponent > 20) { return None }

        immut power = (count << countExponent) * baseExponent
        immut exponent = if (y < float(0)) { -power } else { power }
        return Some(nearest(wide(1, 0), exponent, false, false))
    }

    // A power of more than 64 of a number above 1 has more than 64 bits: neither a float nor a
    // middle. Nor is 1 over one.
    if (y < float(0) or countExponent > 6 or (count << countExponent) > 64) { return None }

    immut n = count << countExponent
    mut product = bigOfInt(1)
    immut factor = bigOfInt(base)

    for _ in range(n) {
        product = multiply(product, factor)
    }

    return Some(nearestOfBig(product, baseExponent * n, false, false))
}

// The bits of a positive int.
function intBits(n: int): int {
    return 128 - leadingZeros(wide(n, 0))
}

// The fast phase: double-double, with bounds proven step by step

// The natural logarithm of `x` (more than 0) in double-double, high + low, and in `error` a bound
// on how far it is from the exact one: x = 2^k m (m from sqrt(2) / 2 to sqrt(2)), and
// log m = 2 atanh(s) = 2s + 2s^3 / 3 + 2s^5 / 5 + ..., s = (m - 1) / (m + 1), |s| at most 0.1716.
//
// The bound, operation by operation (u = 2^-53, the rounding of a float):
// - s in double-double: off by at most 2^-100 of it (f = m - 1 and 2 + f exact, the quotient's
//   rest by a product within 2^-101);
// - s^2 to s^9, each a product of double-doubles (within 2^-100: the products of the halves exact
//   but the last, the sum renormalized exactly), off by at most 9 2^-99 < 2^-95 of themselves;
// - the terms to 2s^9 / 9, with constants within 2^-108, all of the sign of s (no cancellation),
//   summed within 2^-104 each: within 2^-94 of log m;
// - the rest, s^11 (2/11 + ... + 2/29 s^18) in floats: within 2^-48.3 of itself (21 roundings
//   of positive terms, the series cut off past s^29 below 2^-52 of it), and itself below 2^-28.8
//   of log m (s^10 2/11 / 2): within 2^-77 of log m;
// - k log 2: k ln2Hi exact (32 bits, k below 2^11), ln2Hi + ln2Lo within 2^-86.1 of log 2 and
//   k ln2Lo rounded within 2^-85.5 k: within 2^-84 |k|; the last sum within 2^-100 of it all.
// The bound kept is 2^-75 |log m| + 2^-84 |k| + 2^-100 (|k| + 1): a margin of 4 over the sum.
function logTwo(given: float, mut high: float, mut low: float, mut error: float) {
    mut x = given
    mut k = 0

    if (x < 0x1p-1022) {
        x = x * 0x1p54
        k = -54
    }

    immut bits = floatBits(x)
    k += ((bits >> 52) & 0x7FF) - 1023
    mut m = floatOfBits((bits & 0xFFFFFFFFFFFFF) | 0x3FF0000000000000)

    if (m > 0x1.6a09e667f3bcdp0) {
        m = m * 0x1p-1
        k += 1
    }

    // s = f / (2 + f), in double-double.
    immut f = m - 0x1p0
    mut sumHigh = float(0)
    mut sumLow = float(0)
    twoSum(0x1p1, f, mut sumHigh, mut sumLow)
    immut sHigh = f / sumHigh
    mut productHigh = float(0)
    mut productLow = float(0)
    twoProduct(sHigh, sumHigh, mut productHigh, mut productLow)
    immut sLow = (((f - productHigh) - productLow) - sHigh * sumLow) / sumHigh
    // s^2, and the odd powers of s to s^9, in double-double.
    mut squareHigh = float(0)
    mut squareLow = float(0)
    doubleProduct(sHigh, sLow, sHigh, sLow, mut squareHigh, mut squareLow)
    mut cubeHigh = float(0)
    mut cubeLow = float(0)
    doubleProduct(sHigh, sLow, squareHigh, squareLow, mut cubeHigh, mut cubeLow)
    mut fifthHigh = float(0)
    mut fifthLow = float(0)
    doubleProduct(cubeHigh, cubeLow, squareHigh, squareLow, mut fifthHigh, mut fifthLow)
    mut seventhHigh = float(0)
    mut seventhLow = float(0)
    doubleProduct(fifthHigh, fifthLow, squareHigh, squareLow, mut seventhHigh, mut seventhLow)
    mut ninthHigh = float(0)
    mut ninthLow = float(0)
    doubleProduct(seventhHigh, seventhLow, squareHigh, squareLow, mut ninthHigh, mut ninthLow)
    // The rest, s^11 (2/11 + 2/13 s^2 + ... + 2/29 s^18), in double: below 2^-28 of the sum, so
    // its rounding is below 2^-80 of it.
    immut z = squareHigh
    immut series = 0x1.745d1745d1746p-3 + z * (0x1.3b13b13b13b14p-3 + z * (0x1.1111111111111p-3 + z * (0x1.e1e1e1e1e1e1ep-4 + z * (0x1.af286bca1af28p-4 + z * (0x1.8618618618618p-4 + z * (0x1.642c8590b2164p-4 + z * (0x1.47ae147ae147bp-4 + z * (0x1.2f684bda12f68p-4 + z * 0x1.1a7b9611a7b96p-4))))))))
    immut rest = ninthHigh * squareHigh * series
    mut termHigh = float(0)
    mut termLow = float(0)
    mut totalHigh = float(0)
    mut totalLow = float(0)
    // 2/9 s^9 + 2/7 s^7 + 2/5 s^5 + 2/3 s^3 + 2s, from the smallest term.
    doubleProduct(0x1.c71c71c71c71cp-3, 0x1.c71c71c71c71cp-57, ninthHigh, ninthLow, mut termHigh, mut termLow)
    doubleSum(termHigh, termLow, rest, float(0), mut totalHigh, mut totalLow)
    doubleProduct(0x1.2492492492492p-2, 0x1.2492492492492p-56, seventhHigh, seventhLow, mut termHigh, mut termLow)
    doubleSum(termHigh, termLow, totalHigh, totalLow, mut totalHigh, mut totalLow)
    doubleProduct(0x1.999999999999ap-2, -0x1.999999999999ap-56, fifthHigh, fifthLow, mut termHigh, mut termLow)
    doubleSum(termHigh, termLow, totalHigh, totalLow, mut totalHigh, mut totalLow)
    doubleProduct(0x1.5555555555555p-1, 0x1.5555555555555p-55, cubeHigh, cubeLow, mut termHigh, mut termLow)
    doubleSum(termHigh, termLow, totalHigh, totalLow, mut totalHigh, mut totalLow)
    doubleSum(0x1p1 * sHigh, 0x1p1 * sLow, totalHigh, totalLow, mut totalHigh, mut totalLow)
    // Plus k log 2: k ln2Hi is exact (ln2Hi has 32 bits).
    immut dk = float(k)
    immut size = if (dk < float(0)) { -dk } else { dk }
    error = 0x1p-75 * koji_float_abs(totalHigh) + 0x1p-84 * size + 0x1p-100 * (size + 0x1p0)
    doubleSum(dk * 0x1.62e42feep-1, dk * 0x1.a39ef35793c76p-33, totalHigh, totalLow, mut high, mut low)
}

// Double-double arithmetic: a number as high + low, |low| at most half an ulp of high.

// a + b exactly, as high + low (Knuth's two-sum).
function twoSum(a: float, b: float, mut high: float, mut low: float) {
    immut sum = a + b
    immut part = sum - a
    low = (a - (sum - part)) + (b - part)
    high = sum
}

// a * b as high + low, within 2^-101 of it (Dekker's product, without a fused multiply-add): each
// split in its high 26 bits and the 27 others, all the partial products exact but the last.
function twoProduct(a: float, b: float, mut high: float, mut low: float) {
    immut product = a * b
    immut aHigh = floatOfBits(floatBits(a) & -0x8000000)
    immut aLow = a - aHigh
    immut bHigh = floatOfBits(floatBits(b) & -0x8000000)
    immut bLow = b - bHigh
    low = ((aHigh * bHigh - product) + aHigh * bLow + aLow * bHigh) + aLow * bLow
    high = product
}

function doubleSum(aHigh: float, aLow: float, bHigh: float, bLow: float, mut high: float, mut low: float) {
    mut sum = float(0)
    mut error = float(0)
    twoSum(aHigh, bHigh, mut sum, mut error)
    error += aLow + bLow
    high = sum + error
    low = error - (high - sum)
}

function doubleProduct(aHigh: float, aLow: float, bHigh: float, bLow: float, mut high: float, mut low: float) {
    immut product = aHigh * bHigh
    immut aTop = floatOfBits(floatBits(aHigh) & -0x8000000)
    immut aRest = aHigh - aTop
    immut bTop = floatOfBits(floatBits(bHigh) & -0x8000000)
    immut bRest = bHigh - bTop
    immut error = ((aTop * bTop - product) + aTop * bRest + aRest * bTop) + aRest * bRest + (aHigh * bLow + aLow * bHigh)
    high = product + error
    low = error - (high - product)
}

// fdlibm's power (e_pow.c), within 1 ulp: the first guess, which `koji_float_power` checks.
function nearlyPower(x: float, y: float): float {
    immut hx = high(x)
    immut lx = low(x)
    immut hy = high(y)
    immut ly = low(y)
    mut ix = hx & 0x7FFFFFFF
    immut iy = hy & 0x7FFFFFFF

    // x^0 is 1.
    if ((iy | ly) == 0) { return 0x1p0 }

    // Whether y is an integer, odd (1) or even (2), when x < 0.
    mut yisint = 0

    if (hx < 0) {
        if (iy >= 0x43400000) {
            yisint = 2
        } else {
            if (iy >= 0x3FF00000) {
                immut k = (iy >> 20) - 0x3FF

                if (k > 20) {
                    immut j = ly >> (52 - k)

                    if ((j << (52 - k)) == ly) { yisint = 2 - (j & 1) }
                } else {
                    if (ly == 0) {
                        immut j = iy >> (20 - k)

                        if ((j << (20 - k)) == iy) { yisint = 2 - (j & 1) }
                    }
                }
            }
        }
    }

    immut ax = koji_float_abs(x)

    // y is +-1, 2 or 0.5 (but where the result would be beyond the floats).
    if (ly == 0) {
        if (iy == 0x3FF00000) {
            if (hy >= 0) { return x }

            if (ax >= 0x0.8p-1022) { return 0x1p0 / x }
        }

        if (hy == 0x40000000 and ax < 0x1p511) { return x * x }

        if (hy == 0x3FE00000 and hx >= 0) { return koji_float_sqrt(x) }
    }

    // x is +-0 or +-1.
    if (lx == 0 and (ix == 0 or ix == 0x3FF00000)) {
        if (ix == 0) {
            // 0 to a negative power is left out by the callers; to a positive one, 0.
            if (hy < 0) { return infinity(hx < 0 and yisint == 1) }

            return signedZero(hx < 0 and yisint == 1)
        }

        // (-1)^odd is -1.
        if (hx < 0 and yisint == 1) { return -0x1p0 }

        return 0x1p0
    }

    mut n = (hx >> 31) + 1
    // The sign of the result: -1 for a negative base to an odd power.
    immut negative = (n | (yisint - 1)) == 0
    immut s = if (negative) { -0x1p0 } else { 0x1p0 }
    mut t1 = float(0)
    mut t2 = float(0)

    // |y| > 2^31: beyond the floats, unless x is close to 1.
    if (iy > 0x41E00000) {
        if (iy > 0x43F00000) {
            if (ix <= 0x3FEFFFFF) { return if (hy < 0) { infinity(false) } else { float(0) } }

            if (ix >= 0x3FF00000) { return if (hy > 0) { infinity(false) } else { float(0) } }
        }

        if (ix < 0x3FEFFFFF) { return if (hy < 0) { infinity(negative) } else { signedZero(negative) } }

        if (ix > 0x3FF00000) { return if (hy > 0) { infinity(negative) } else { signedZero(negative) } }

        // |1 - x| <= 2^-20: log(x) by x - x^2/2 + x^3/3 - x^4/4.
        immut t = ax - 0x1p0
        immut w = (t * t) * (0x1p-1 - t * (0x1.5555555555555p-2 - t * 0x1p-2))
        immut u = 0x1.715476p0 * t
        immut v = t * 0x1.4ae0bf85ddf44p-26 - w * 0x1.71547652b82fep0
        t1 = withLow(u + v, 0)
        t2 = v - (t1 - u)
    } else {
        mut ax2 = ax
        n = 0

        // A subnormal, scaled up.
        if (ix < 0x00100000) {
            ax2 = ax2 * 0x1p53
            n -= 53
            ix = high(ax2)
        }

        n += (ix >> 20) - 0x3FF
        immut j = ix & 0x000FFFFF
        // The interval of x.
        ix = j | 0x3FF00000
        mut k = 0

        if (j > 0x3988E) {
            if (j < 0xBB67A) {
                k = 1
            } else {
                n += 1
                ix -= 0x00100000
            }
        }

        ax2 = withHigh(ax2, ix)
        immut bp = if (k == 1) { 0x1.8p0 } else { 0x1p0 }
        immut dpH = if (k == 1) { 0x1.2b8034p-1 } else { float(0) }
        immut dpL = if (k == 1) { 0x1.cfdeb43cfd006p-27 } else { float(0) }
        // ss = s_h + s_l = (x - 1) / (x + 1) or (x - 1.5) / (x + 1.5).
        immut u = ax2 - bp
        immut v = 0x1p0 / (ax2 + bp)
        immut ss = u * v
        immut sH = withLow(ss, 0)
        // t_h = ax + bp, its high part.
        immut tH = fromWords(((ix >> 1) | 0x20000000) + 0x00080000 + (k << 18), 0)
        immut tL = ax2 - (tH - bp)
        immut sL = v * ((u - sH * tH) - sH * tL)
        // log(ax).
        mut s2 = ss * ss
        mut r = s2 * s2 * (0x1.3333333333303p-1 + s2 * (0x1.b6db6db6fabffp-2 + s2 * (0x1.55555518f264dp-2 + s2 * (0x1.17460a91d4101p-2 + s2 * (0x1.d864a93c9db65p-3 + s2 * 0x1.a7e284a454eefp-3)))))
        r += sL * (sH + ss)
        s2 = sH * sH
        immut tH2 = withLow(0x1.8p1 + s2 + r, 0)
        immut tL2 = r - ((tH2 - 0x1.8p1) - s2)
        // u + v = ss * (1 + ...).
        immut u2 = sH * tH2
        immut v2 = sL * tH2 + tL2 * ss
        // 2 / (3 log 2) * (ss + ...).
        immut pH = withLow(u2 + v2, 0)
        immut pL = v2 - (pH - u2)
        immut zH = 0x1.ec709ep-1 * pH
        immut zL = -0x1.e2fe0145b01f5p-28 * pH + pL * 0x1.ec709dc3a03fdp-1 + dpL
        // log2(ax) = (ss + ...) * 2 / (3 log 2) = n + dp_h + z_h + z_l.
        immut t = float(n)
        t1 = withLow(((zH + zL) + dpH) + t, 0)
        t2 = zL - (((t1 - t) - dpH) - zH)
    }

    // y split as y1 + y2, and (y1 + y2) * (t1 + t2).
    immut y1 = withLow(y, 0)
    mut pL = (y - y1) * t1 + y * t2
    mut pH = y1 * t1
    mut z = pL + pH
    mut j = high(z)
    immut i = low(z)

    // z >= 1024: beyond the floats; z <= -1075: 0.
    if (j >= 0x40900000) {
        if (((j - 0x40900000) | i) != 0) { return infinity(negative) }

        if (pL + 0x1.71547652b82fep-54 > z - pH) { return infinity(negative) }
    } else {
        if ((j & 0x7FFFFFFF) >= 0x4090CC00) {
            if ((((j & 0xFFFFFFFF) - 0xC090CC00) | i) != 0) { return signedZero(negative) }

            if (pL <= z - pH) { return signedZero(negative) }
        }
    }

    // 2^(p_h + p_l).
    immut magnitude = j & 0x7FFFFFFF
    mut k = (magnitude >> 20) - 0x3FF
    n = 0

    // |z| > 0.5: n = [z + 0.5].
    if (magnitude > 0x3FE00000) {
        n = j + (0x00100000 >> (k + 1))
        k = ((n & 0x7FFFFFFF) >> 20) - 0x3FF
        immut t = fromWords(n & ~(0x000FFFFF >> k), 0)
        n = ((n & 0x000FFFFF) | 0x00100000) >> (20 - k)

        if (j < 0) { n = -n }

        pH -= t
    }

    immut t = withLow(pL + pH, 0)
    immut u = t * 0x1.62e43p-1
    immut v = (pL - (t - pH)) * 0x1.62e42fefa39efp-1 + t * -0x1.05c610ca86c39p-29
    z = u + v
    immut w = v - (z - u)
    immut tt = z * z
    t1 = z - tt * (0x1.555555555553ep-3 + tt * (-0x1.6c16c16bebd93p-9 + tt * (0x1.1566aaf25de2cp-14 + tt * (-0x1.bbd41c5d26bf1p-20 + tt * 0x1.6376972bea4dp-25))))
    immut r = (z * t1) / (t1 - 0x1p1) - (w + z * w)
    z = 0x1p0 - (r - z)
    j = high(z) + (n << 20)

    // A subnormal result: scaled down in two steps, the second one rounding once.
    if ((j >> 20) <= 0) { return s * (z * powerOfTwo(n + 1022)) * powerOfTwo(-1022) }

    return s * withHigh(z, j)
}

// The float of a decimal text (`strtod`)

// The float nearest to the number written from `text` for `size` bytes, as Koji and C write
// numbers: a sign, digits with a point, an exponent (`-12.5e-3`). An infinity when it is beyond
// the floats. Exact: the digits as a big integer, times or divided by the power of 10.
extern function koji_float_parse(text: Address, size: int): float {
    mut at = 0
    mut negative = false
    mut digits: int[] = []
    mut exponent = 0

    if (at < size and (byteAt(text, at) == 45 or byteAt(text, at) == 43)) {
        negative = byteAt(text, at) == 45
        at += 1
    }

    while (at < size and isDigit(byteAt(text, at))) {
        addDigit(byteAt(text, at) - 48, mut digits)
        at += 1
    }

    if (at < size and byteAt(text, at) == 46) {
        at += 1

        while (at < size and isDigit(byteAt(text, at))) {
            addDigit(byteAt(text, at) - 48, mut digits)
            exponent -= 1

            at += 1
        }
    }

    if (at < size and (byteAt(text, at) == 101 or byteAt(text, at) == 69)) {
        at += 1
        mut negativePower = false

        if (at < size and (byteAt(text, at) == 45 or byteAt(text, at) == 43)) {
            negativePower = byteAt(text, at) == 45
            at += 1
        }

        mut power = 0

        while (at < size and isDigit(byteAt(text, at))) {
            if (power < 100000) { power = power * 10 + byteAt(text, at) - 48 }

            at += 1
        }

        exponent += if (negativePower) { -power } else { power }
    }

    return nearestOfDecimal(digits, exponent, negative)
}

function byteAt(text: Address, at: int): int {
    immut b: byte = read(text, at)
    return int(b)
}

function isDigit(b: int): boolean {
    return b >= 48 and b <= 57
}

// Adds a digit to the significant ones: none before the first that is not 0.
function addDigit(digit: int, mut digits: int[]) {
    if (digits.length() == 0 and digit == 0) { return }

    digits.push(digit)
}

// The most digits kept: more than the 767 that a float can need to be told from its neighbors; a
// digit 1 after them stands for those left out, when one of them is not 0.
immut keptDigits = 800

// The float nearest to `digits` (decimal, the first not 0) times 10^`exponent`.
function nearestOfDecimal(given: int[], givenExponent: int, negative: boolean): float {
    mut digits = given
    mut exponent = givenExponent

    // The zeros at the end: a power of 10.
    while (digits.length() > 0 and digits[digits.length() - 1] == 0) {
        digits.pop()
        exponent += 1
    }

    if (digits.length() == 0) { return signedZero(negative) }

    if (digits.length() > keptDigits) {
        exponent += digits.length() - keptDigits
        digits = digits[0..keptDigits]
        digits.push(1)
        exponent -= 1
    }

    // Beyond the floats, or below half the smallest one.
    immut magnitude = digits.length() + exponent

    if (magnitude > 310) { return infinity(negative) }

    if (magnitude < -326) { return signedZero(negative) }

    mut fast = float(0)

    if (nearestOfFives(digits, exponent, negative, mut fast)) { return fast }

    immut number = bigOfDigits(digits)

    if (exponent >= 0) {
        immut product = bigTimesTenTo(number, exponent)
        return nearestOfBig(product, 0, false, negative)
    }

    // number / 10^-exponent: a quotient of some 66 bits, from the number or the divisor shifted to
    // the left.
    immut shift = bitLength(bigTimesTenTo([1], -exponent)) - bitLength(number) + 66
    immut divisor = shiftLeft(bigTimesTenTo([1], -exponent), if (shift < 0) { -shift } else { 0 })
    mut rest = shiftLeft(number, if (shift > 0) { shift } else { 0 })
    mut quotient: U128 = 0
    mut place = bitLength(rest) - bitLength(divisor)

    while (place >= 0) {
        immut part = shiftLeft(divisor, place)

        if (compare(rest, part) >= 0) {
            rest = subtract(rest, part)
            immut one: U128 = 1
            quotient = quotient | (one << wide(place, 0))
        }

        place -= 1
    }

    return nearest(quotient, -shift, not isZero(rest), negative)
}

// The fast way to the float of digits times 10^`exponent`, by the tables of powers of 5 of Ryu
// (std/koji/ryu.kj): the first 18 digits w (w + 1 bounds the number when there are more), and
// 10^q = 5^q 2^q, 5^q between P and P + 1 times a power of 2 (P its first 125 bits, cut), or
// 5^-q between I - 1 and I times one (I = 2^B / 5^q + 1, B its bits - 1 + 125). The number is
// then between two products; when both round to the same float, it is that float. Otherwise (the
// number within 2^-120 or so of the middle of two floats, or exactly on it), the exact way.
function nearestOfFives(digits: int[], exponent: int, negative: boolean, mut result: float): boolean {
    immut count = if (digits.length() > 18) { 18 } else { digits.length() }
    mut w = 0

    for i in range(count) {
        w = w * 10 + digits[i]
    }

    immut more = if (digits.length() > count) { 1 } else { 0 }
    immut q = exponent + digits.length() - count

    if (q > 325 or q < -341) { return false }

    mut low: int[] = []
    mut high: int[] = []
    mut scale = 0

    if (q >= 0) {
        immut power = tableNumber(powersOfFive, q)
        // 5^q has 125 bits or fewer: P is exact, shifted to 125 bits.
        immut fiveBits = bitsOfFivePower(q)
        immut shift = fiveBits - 125
        immut cut = if (shift > 0) { 1 } else { 0 }
        low = multiply(bigOfInt(w), power)
        high = multiply(bigOfInt(w + more), add(power, bigOfInt(cut)))
        scale = shift + q
    } else {
        immut inverse = tableNumber(inversePowersOfFive, -q)
        low = multiply(bigOfInt(w), subtract(inverse, bigOfInt(1)))
        high = multiply(bigOfInt(w + more), inverse)
        scale = q - (bitsOfFivePower(-q) - 1 + 125)
    }

    immut lowFloat = nearestOfBig(low, scale, false, negative)
    immut highFloat = nearestOfBig(high, scale, false, negative)

    if (floatBits(lowFloat) != floatBits(highFloat)) { return false }

    result = lowFloat
    return true
}

// The number i of a table of Ryu: 32 hexadecimal digits, as a big integer.
function tableNumber(table: string, i: int): int[] {
    immut bytes = stringBytes(table)
    mut n: int[] = []

    for at in range(32 * i, 32 * i + 32) {
        immut code = byteAt(bytes, at)
        immut digit = if (code >= 97) { code - 87 } else { code - 48 }
        multiplyAdd(mut n, 16, digit)
    }

    return n
}

// The bits of 5^i: floor(i log2 5) + 1 (exact for i below 2^30 with this fraction of log2 5).
function bitsOfFivePower(i: int): int {
    return ((i * 1217359) >> 19) + 1
}

// The nearest float to a big integer times 2^`exponent`: its top 64 bits, the others as sticky.
function nearestOfBig(n: int[], exponent: int, sticky: boolean, negative: boolean): float {
    immut length = bitLength(n)

    if (length <= 64) { return nearest(topBits(n, 0), exponent, sticky, negative) }

    immut dropped = length - 64
    return nearest(topBits(n, dropped), exponent + dropped, sticky or lowBitsSet(n, dropped), negative)
}

// Big integers: limbs of 30 bits, the lowest first, none 0 at the end (0 is no limbs); never
// negative. A product of two limbs, plus a limb and a carry, fits an int.

function bigOfInt(given: int): int[] {
    mut n: int[] = []
    mut rest = given

    while (rest > 0) {
        n.push(rest & 0x3FFFFFFF)
        rest = rest >> 30
    }

    return n
}

function bigOfDigits(digits: int[]): int[] {
    mut n: int[] = []
    mut at = 0

    while (at < digits.length()) {
        mut chunk = 0
        mut factor = 1
        mut count = 0

        while (count < 9 and at < digits.length()) {
            chunk = chunk * 10 + digits[at]
            factor *= 10
            count += 1
            at += 1
        }

        multiplyAdd(mut n, factor, chunk)
    }

    return n
}

// n * factor + addend, in place (factor and addend below 2^31).
function multiplyAdd(mut n: int[], factor: int, addend: int) {
    mut carry = addend

    for i in range(n.length()) {
        immut t = n[i] * factor + carry
        n[i] = t & 0x3FFFFFFF
        carry = t >> 30
    }

    while (carry != 0) {
        n.push(carry & 0x3FFFFFFF)
        carry = carry >> 30
    }
}

function bigTimesTenTo(given: int[], power: int): int[] {
    mut n = given
    mut left = power

    while (left >= 9) {
        multiplyAdd(mut n, 1000000000, 0)
        left -= 9
    }

    mut factor = 1

    for _ in range(left) {
        factor *= 10
    }

    if (factor > 1) { multiplyAdd(mut n, factor, 0) }

    return n
}

// n * factor (factor from 0 to 2^31).
function multiplySmall(n: int[], factor: int): int[] {
    if (factor == 0) { return [] }

    mut out = n
    multiplyAdd(mut out, factor, 0)
    return out
}

function multiply(a: int[], b: int[]): int[] {
    if (a.length() == 0 or b.length() == 0) { return [] }

    mut out: int[] = []

    for _ in range(a.length() + b.length()) {
        out.push(0)
    }

    for i in range(a.length()) {
        mut carry = 0
        immut ai = a[i]

        for j in range(b.length()) {
            immut t = out[i + j] + ai * b[j] + carry
            out[i + j] = t & 0x3FFFFFFF
            carry = t >> 30
        }

        mut at = i + b.length()

        while (carry != 0) {
            immut t = out[at] + carry
            out[at] = t & 0x3FFFFFFF
            carry = t >> 30
            at += 1
        }
    }

    return trimmed(out)
}

function add(a: int[], b: int[]): int[] {
    mut out: int[] = []
    mut carry = 0
    immut count = if (a.length() > b.length()) { a.length() } else { b.length() }

    for i in range(count) {
        immut t = (if (i < a.length()) { a[i] } else { 0 }) + (if (i < b.length()) { b[i] } else { 0 }) + carry
        out.push(t & 0x3FFFFFFF)
        carry = t >> 30
    }

    if (carry != 0) { out.push(carry) }

    return out
}

// a - b, for a >= b.
function subtract(a: int[], b: int[]): int[] {
    mut out: int[] = []
    mut borrow = 0

    for i in range(a.length()) {
        mut t = a[i] - borrow - (if (i < b.length()) { b[i] } else { 0 })
        borrow = 0

        if (t < 0) {
            t += 0x40000000
            borrow = 1
        }

        out.push(t)
    }

    return trimmed(out)
}

function trimmed(given: int[]): int[] {
    mut n = given

    while (n.length() > 0 and n[n.length() - 1] == 0) {
        n.pop()
    }

    return n
}

function compare(a: int[], b: int[]): int {
    if (a.length() != b.length()) { return if (a.length() < b.length()) { -1 } else { 1 } }

    for i in range(a.length() - 1, -1, -1) {
        if (a[i] != b[i]) { return if (a[i] < b[i]) { -1 } else { 1 } }
    }

    return 0
}

function isZero(n: int[]): boolean {
    return n.length() == 0
}

function bitLength(n: int[]): int {
    if (n.length() == 0) { return 0 }

    return (n.length() - 1) * 30 + intBits(n[n.length() - 1])
}

function shiftLeft(n: int[], bits: int): int[] {
    if (n.length() == 0) { return [] }

    immut limbs = bits / 30
    immut rest = bits % 30
    mut out: int[] = []

    for _ in range(limbs) {
        out.push(0)
    }

    mut carry = 0

    for limb in n {
        immut shifted = (limb << rest) | carry
        out.push(shifted & 0x3FFFFFFF)
        carry = shifted >> 30
    }

    if (carry != 0) { out.push(carry) }

    return out
}

// n / 2^bits, rounded down.
function shiftRight(n: int[], bits: int): int[] {
    immut limbs = bits / 30
    immut rest = bits % 30
    mut out: int[] = []

    for i in range(limbs, n.length()) {
        immut above = if (i + 1 < n.length()) { n[i + 1] } else { 0 }
        out.push(((n[i] >> rest) | (above << (30 - rest))) & 0x3FFFFFFF)
    }

    return trimmed(out)
}

// n / divisor rounded down (divisor from 1 to 2^31).
function divideSmall(n: int[], divisor: int): int[] {
    mut out: int[] = []

    for _ in range(n.length()) {
        out.push(0)
    }

    mut rest = 0

    for i in range(n.length() - 1, -1, -1) {
        immut t = (rest << 30) | n[i]
        out[i] = t / divisor
        rest = t % divisor
    }

    return trimmed(out)
}

// n / divisor rounded down (divisor from 1 to 2^62): the rest and a limb in a U128.
function divideByInt(n: int[], divisor: int): int[] {
    mut out: int[] = []

    for _ in range(n.length()) {
        out.push(0)
    }

    mut rest: U128 = 0
    immut wideDivisor = wide(divisor, 0)

    for i in range(n.length() - 1, -1, -1) {
        immut t = (rest << 30) | wide(n[i], 0)
        out[i] = lowWord(t / wideDivisor)
        rest = t % wideDivisor
    }

    return trimmed(out)
}

// a / b rounded down (b not 0), bit by bit.
function divide(a: int[], b: int[]): int[] {
    mut rest = a
    mut quotient: int[] = []
    mut place = bitLength(a) - bitLength(b)

    while (place >= 0) {
        immut part = shiftLeft(b, place)

        if (compare(rest, part) >= 0) {
            rest = subtract(rest, part)
            quotient = add(quotient, shiftLeft(bigOfInt(1), place))
        }

        place -= 1
    }

    return quotient
}

// The bits of n from `start` up (at most 64 of them), as a U128.
function topBits(n: int[], start: int): U128 {
    mut value: U128 = 0
    immut limbs = start / 30
    immut rest = start % 30

    for i in range(n.length() - 1, limbs - 1, -1) {
        value = (value << 30) | wide(n[i], 0)
    }

    return value >> wide(rest, 0)
}

// Whether a bit of n below `count` is 1.
function lowBitsSet(n: int[], count: int): boolean {
    immut limbs = count / 30

    for i in range(limbs) {
        if (i < n.length() and n[i] != 0) { return true }
    }

    immut rest = count % 30

    if (rest == 0 or limbs >= n.length()) { return false }

    return (n[limbs] & ((1 << rest) - 1)) != 0
}
