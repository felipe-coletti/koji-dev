// `koji:sockets`: the numbers of the sockets that koji:net needs and that differ between systems,
// the record the module of each system fills in (`socketNumbers` of koji:os).

export type SocketNumbers = {
    // SOL_SOCKET, SO_REUSEADDR, SO_ERROR.
    level: int
    reuseAddress: int
    socketError: int
    // EWOULDBLOCK (EAGAIN), EINPROGRESS, ETIMEDOUT (Winsock's own on Windows).
    wouldBlock: int
    inProgress: int
    timedOut: int
    // The place of ai_addr in a `struct addrinfo` (after ai_canonname on a BSD and on Windows).
    addressAt: int
    // Whether a `struct sockaddr_in` starts with its length (a BSD).
    addressLength: boolean
}
