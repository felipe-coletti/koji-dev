// `koji:posix`: what the systems of POSIX (Linux, macOS, the BSDs) share in the runtime, in the
// library of the runtime written in Koji: the stacks of tasks mapped from the system, its clocks
// and its sleeps. What differs between them is in their own modules (koji:linux, koji:bsd), given
// to these functions; Windows has koji:windows.

import { Address, CInt, CSize, CVariadic, distance, nullAddress, offset, read, valgrind, write } from 'koji:unsafe'

extern function mmap(address: Address, size: CSize, protection: CInt, flags: CInt, fd: CInt, at: int): Address
extern function munmap(address: Address, size: CSize): CInt
extern function mprotect(address: Address, size: CSize, protection: CInt): CInt
extern function clock_gettime(clock: CInt, time: Address): CInt
extern function nanosleep(request: Address, remaining: Address): CInt
extern function fcntl(fd: CInt, command: CInt, argument: CVariadic): CInt
extern function poll(fds: Address, count: CSize, timeout: CInt): CInt
extern function pipe(fds: Address): CInt
extern function pthread_create(thread: Address, attributes: Address, start: Address, argument: Address): CInt
extern function pthread_detach(thread: int): CInt
extern function systemRead(fd: CInt, bytes: Address, size: CSize): int from 'read'
extern function systemWrite(fd: CInt, bytes: Address, size: CSize): int from 'write'
extern function writev(fd: CInt, buffers: Address, count: CInt): int
extern function fdopen(fd: CInt, mode: Address): Address
extern function time(place: Address): int
extern function getentropy(buffer: Address, size: CSize): CInt

// A stack of `size` bytes above a guard of `guard` that the program cannot touch (PROT_NONE),
// readable and writable (PROT_READ | PROT_WRITE), with the flags of the mapping of the system: its
// memory given as it is first used. Valgrind is told of it (VG_USERREQ__STACK_REGISTER), which
// keeps the number it gives in the last word of the stack.
export function posixStackNew(size: int, guard: int, flags: int): Address {
    immut block = mmap(nullAddress(), size + guard, 3, flags, -1, 0)

    if (distance(nullAddress(), block) == -1) { return nullAddress() }

    if (mprotect(block, guard, 0) != 0) {
        munmap(block, size + guard)
        return nullAddress()
    }

    immut stack = offset(block, guard)
    immut low = distance(nullAddress(), stack)
    write(stack, size - 8, valgrind(0x1501, low, low + size, 0))
    return stack
}

export function posixStackFree(stack: Address, size: int, guard: int) {
    immut registered: int = read(stack, size - 8)
    valgrind(0x1502, registered, 0, 0)
    munmap(offset(stack, -guard), size + guard)
}

// The nanoseconds of the clock `clock` of the system, from a `struct timespec` (seconds,
// nanoseconds) at `words`.
export function posixNanoseconds(clock: int, words: Address): int {
    clock_gettime(clock, words)
    immut seconds: int = read(words, 0)
    immut nanoseconds: int = read(words, 8)
    return seconds * 1000000000 + nanoseconds
}

// Sleeps `nanoseconds` (a signal may end it early), with a `struct timespec` at `words`.
export function posixSleep(nanoseconds: int, words: Address) {
    write(words, 0, nanoseconds / 1000000000)
    write(words, 8, nanoseconds % 1000000000)
    nanosleep(words, nullAddress())
}

// A socket (or pipe) waits or not: O_NONBLOCK (`nonBlocking`, its number on the system) cleared or
// set (F_GETFL, F_SETFL).
export function posixSetWaiting(fd: int, waiting: boolean, nonBlocking: int) {
    immut flags = fcntl(fd, 3, 0)
    fcntl(fd, 4, if (waiting) { flags & ~nonBlocking } else { flags | nonBlocking })
}

// A socket that the programs a program runs do not get (F_SETFD, FD_CLOEXEC).
export function posixPrivate(fd: int) {
    if (fd >= 0) { fcntl(fd, 2, 1) }
}

// Whether a write to `fd` would not wait (poll: POLLOUT at once), a `struct pollfd` at `place`: the
// descriptor (4 bytes), the events (2), the events that came (2).
export function posixOutputReady(fd: int, place: Address): boolean {
    write(place, 0, fd & 0xFFFFFFFF | 4 << 32)
    immut answer = poll(place, 1, 0)
    immut events: int = read(place, 0)
    return answer == 1 and (events >> 48) & 4 != 0
}

// A pipe, its two ends (ints of C) at `ends`, which the programs a program runs do not get
// (FD_CLOEXEC): whether the system made it.
export function posixPipe(ends: Address): boolean {
    if (pipe(ends) != 0) { return false }

    immut both: int = read(ends, 0)
    fcntl(both & 0xFFFFFFFF, 2, 1)
    fcntl((both >> 32) & 0xFFFFFFFF, 2, 1)
    return true
}

// A new thread running `code` with `state` (a pthread_t at `place`), detached: whether the system
// made it.
export function posixThreadStart(code: Address, state: Address, place: Address): boolean {
    immut made = pthread_create(place, nullAddress(), code, state) == 0

    if (made) {
        immut id: int = read(place, 0)
        pthread_detach(id)
    }

    return made
}

export function posixWrite(fd: int, bytes: Address, size: int): int {
    return systemWrite(fd, bytes, size)
}

export function posixRead(fd: int, bytes: Address, size: int): int {
    return systemRead(fd, bytes, size)
}

// `writev` of `count` buffers (an address and a size each).
export function posixWritev(fd: int, buffers: Address, count: int): int {
    return writev(fd, buffers, count)
}

// A stream of C of `fd`.
export function posixStream(fd: int, mode: Address): Address {
    return fdopen(fd, mode)
}

// The seconds since 1970, now.
export function posixSeconds(): int {
    return time(nullAddress())
}

// `size` random bytes at `bytes` (at most 256): whether the system gave them.
export function posixRandom(bytes: Address, size: int): boolean {
    return getentropy(bytes, size) == 0
}
