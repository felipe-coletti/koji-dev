// `koji:linux`: what Linux asks of the runtime, in the library of the runtime written in Koji: its
// constants, and its poller (epoll). The rest it shares with the other systems of POSIX
// (koji:posix).

import system
import { Address, CInt, read, write } from 'koji:unsafe'

extern function epoll_create1(flags: CInt): CInt
extern function epoll_ctl(poller: CInt, operation: CInt, fd: CInt, event: Address): CInt
extern function epoll_wait(poller: CInt, events: Address, capacity: CInt, milliseconds: CInt): CInt
extern function koji_system_errno(): CInt

// The flags of the mapping of a stack: MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE.
export function linuxStackFlags(): int {
    return 2 | 0x20 | 0x4000
}

// CLOCK_MONOTONIC.
export function linuxMonotonicClock(): int {
    return 1
}

// The poller: epoll (EPOLL_CLOEXEC).
export function linuxPollerNew(): int {
    return epoll_create1(0x80000)
}

// The place of `data` in a `struct epoll_event` (after `events`, of 4 bytes): packed on x86-64.
function epollData(): int {
    return match (system.architecture) {
        X64 => 4
        _ => 8
    }
}

// Watches `fd` until it is ready to read (or to write), with a `struct epoll_event` at `words`:
// EPOLLIN or EPOLLOUT, with EPOLLONESHOT; EPOLL_CTL_MOD, or EPOLL_CTL_ADD for a socket not
// watched yet (ENOENT). 0, or -1 (errno says why).
export function linuxPollerWatch(poller: int, fd: int, writing: boolean, words: Address): int {
    write(words, 0, (if (writing) { 4 } else { 1 }) | 1 << 30)
    write(words, epollData(), fd)

    if (epoll_ctl(poller, 3, fd, words) == 0) { return 0 }

    if (koji_system_errno() != 2) { return -1 }

    return epoll_ctl(poller, 1, fd, words)
}

// Waits at most `milliseconds` (-1: as long as it takes) for at most `most` sockets, their events
// at `events`: how many are ready (0 for a signal, EINTR), their numbers at `ready`, or -1.
export function linuxPollerWait(poller: int, milliseconds: int, ready: Address, most: int, events: Address): int {
    immut size = epollData() + 8
    immut count = epoll_wait(poller, events, most, milliseconds)

    if (count < 0) { return if (koji_system_errno() == 4) { 0 } else { -1 } }

    for i in range(count) {
        immut fd: int = read(events, i * size + epollData())
        write(ready, 8 * i, fd)
    }

    return count
}
