// The `time` module: the clocks of the system, and pauses (see doc/standard-library/time.md).
// Times are in seconds, as decimals, exact to the nanosecond. A timestamp counts the seconds since
// 0000-01-01 00:00:00 UTC, the epoch of Koji (in the proleptic Gregorian calendar).

import math
import system
import { monotonicSeconds, realtimeSeconds } from 'koji:host'

// `int clock_gettime(clockid_t clock, struct timespec *time)`: a `timespec` is two 8-byte words,
// seconds and nanoseconds. The waits of tasks (koji:task) and the monotonic clock in nanoseconds
// (koji:prelude).
extern function koji_task_sleep_until(deadline: int)
extern function koji_monotonic_nanoseconds(): int
// Windows (kernel32): the time in hundreds of nanoseconds since 1601-01-01.

// The seconds from 0000-01-01 to 1970-01-01, the epoch of Unix and of the clock of the system
// (719,528 days).
immut unixEpoch = 62167219200

// The current time: the seconds since 0000-01-01 00:00:00 UTC. It follows the clock of the
// system, which may be set back or forth.
export function now(): decimal {
    return realtimeSeconds() + unixEpoch
}

// A time that only grows, for durations: the difference of two is the time between them.
export function monotonic(): decimal {
    return monotonicSeconds()
}

// Pauses for `seconds` (nothing for zero or less): the current task waits, and the other tasks run
// (see the `task` module).
export function sleep(seconds: decimal) {
    if (seconds <= 0) { return }

    // At most a hundred years, which the nanoseconds of an int still count.
    immut capped = if (seconds > 3155760000) { decimal(3155760000) } else { seconds }
    koji_task_sleep_until(koji_monotonic_nanoseconds() + math.floor(capped * 1000000000))
}
