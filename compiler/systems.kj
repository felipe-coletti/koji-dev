// The systems Koji builds for: the one place that names them. Each system describes itself in a
// module of its own (linux.kj, macos.kj, windows.kj: a `SystemDescription` of platform.kj, in
// capabilities: its formats, its linker, its conventions); this module only says which one the
// target is, and gives the rest of the compiler the answers of that description, and the formats
// of objects and archives it names. A new system is a variant of `System`, its line here and its
// module (with new formats, if it needs some); a system dropped, the same removed.
//
// What differs by processor (x86-64, arm64) is another matter, the emitters' (x64.kj, a64.kj).

import { targetPlatform } from 'inline.kj'
import { ObjectFile } from 'objects.kj'
import { elfObject } from 'elf.kj'
import { machArchive, machObject } from 'macho.kj'
import { coffGlobals, coffObject } from 'coff.kj'
import { archive, archiveNamed } from 'linker.kj'
import { ArmFeatures, EnvironmentAccess, Linker, SystemDescription, Elf, MachO, Coff, SystemVArchive, BsdArchive, CoffArchive } from 'platform.kj'
import { linuxSystem } from 'linux.kj'
import { macosSystem } from 'macos.kj'
import { windowsSystem } from 'windows.kj'

// The systems, in the order of the variants of `system.OperatingSystem` (the platforms of
// target.kj: `system * 3 + architecture`).
export type System = {
    Linux
    MacOS
    Windows
}

// The system compiled for: the one of KOJI_TARGET, else this one.
export function targetSystem(): System {
    immut index = targetPlatform() / 3
    return if (index == 1) { MacOS } else { if (index == 2) { Windows } else { Linux } }
}

// Whether the processor is arm64 (else x86-64).
export function targetArm(): boolean {
    return targetPlatform() % 3 == 1
}

// The description of the system compiled for, by its module.
export function target(): SystemDescription {
    return match (targetSystem()) {
        Linux => linuxSystem()
        MacOS => macosSystem()
        Windows => windowsSystem()
    }
}

// The relocatable object of the code and the data, in the format of the system.
export function objectOf(file: ObjectFile): byte[] {
    return match (target().object) {
        Elf => elfObject(file)
        MachO => machObject(file)
        Coff => coffObject(file)
    }
}

// The archive of the runtime library (`kojic library`), with the table of its symbols.
export function libraryArchive(object: byte[]): byte[] {
    return match (target().archive) {
        SystemVArchive => archive([object])
        BsdArchive => machArchive([object])
        CoffArchive => archiveNamed([object], [coffGlobals(object)])
    }
}

// The answers of the description (see platform.kj).
export function targetLinker(): Linker {
    return target().linker
}

export function windowsCalls(): boolean {
    return target().windowsCalls
}

export function variadicsOnStack(): boolean {
    return target().variadicsOnStack
}

export function errnoFunction(): string {
    return target().errnoFunction
}

export function ownEntry(): boolean {
    return target().ownEntry
}

export function threadAdapters(): boolean {
    return target().threadAdapters
}

export function environmentAccess(): EnvironmentAccess {
    return target().environment
}

export function sleepsInMilliseconds(): boolean {
    return target().sleepsInMilliseconds
}

export function stackLimitsInThread(): boolean {
    return target().stackLimitsInThread
}

export function armFeatures(): ArmFeatures {
    return target().armFeatures
}

// The name of the system for messages and for KOJI_TARGET (`windows-x64`).
export function systemName(): string {
    return target().name
}
