// The systems Koji builds for, and what each one asks of the compiler, in one place. Each decision
// that differs between systems is a function here, a `match` on the system with no wildcard: a new
// system is a new variant of `System`, and the checker then names every decision it must make
// (and the modules it needs: its object, its archive, its linker); a system dropped is a variant
// and its modules removed. The rest of the compiler asks these functions, never the platform.
//
// What differs by processor (x86-64, arm64) is another matter, the emitters' (x64.kj, a64.kj); the
// library has its own branches for each system (`match (system.os)`, see target.kj).

import { targetPlatform } from 'inline.kj'
import { ObjectFile } from 'objects.kj'
import { elfObject } from 'elf.kj'
import { machArchive, machObject } from 'macho.kj'
import { coffGlobals, coffObject } from 'coff.kj'
import { archive, archiveNamed } from 'linker.kj'

// The systems, in the order of the variants of `system.OperatingSystem` (the platforms of
// target.kj: `system * 3 + architecture`).
export type System = {
    Linux
    MacOS
    Windows
}

// The system compiled for: the one of KOJI_TARGET, else this one.
export function targetSystem(): System {
    immut index = targetPlatform() / 3
    return if (index == 1) { MacOS } else { if (index == 2) { Windows } else { Linux } }
}

// Whether the processor is arm64 (else x86-64).
export function targetArm(): boolean {
    return targetPlatform() % 3 == 1
}

// The relocatable object of the code and the data: ELF, Mach-O or COFF.
export function objectOf(file: ObjectFile): byte[] {
    return match (targetSystem()) {
        Linux => elfObject(file)
        MacOS => machObject(file)
        Windows => coffObject(file)
    }
}

// The archive of the runtime library (`kojic library`), with the table of its symbols: of System V
// for Linux, of BSD for macOS (its linker reads no other), with the names of COFF for Windows.
export function libraryArchive(object: byte[]): byte[] {
    return match (targetSystem()) {
        Linux => archive([object])
        MacOS => machArchive([object])
        Windows => archiveNamed([object], [coffGlobals(object)])
    }
}

// Whether the functions of C (of the system, of a DLL) are called by the convention of Windows
// (x64.kj: the first four arguments in rcx, rdx, r8, r9 or xmm0 to xmm3, 32 bytes above them),
// rather than System V's.
export function windowsCalls(): boolean {
    return match (targetSystem()) {
        Linux => false
        MacOS => false
        Windows => true
    }
}

// Whether, on arm64, the arguments after the fixed ones of a variadic function of C go on the stack
// (the convention of macOS), rather than in registers as the others.
export function variadicsOnStack(): boolean {
    return match (targetSystem()) {
        Linux => false
        MacOS => true
        Windows => false
    }
}

// The function of the C library that gives the address of errno.
export function errnoFunction(): string {
    return match (targetSystem()) {
        Linux => '__errno_location'
        MacOS => '__error'
        Windows => '_errno'
    }
}

// Whether the system starts a program at an entry of its own (Windows, with no arguments: those of C
// from its C library), rather than the start files of C calling `main`.
export function ownEntry(): boolean {
    return match (targetSystem()) {
        Linux => false
        MacOS => false
        Windows => true
    }
}

// Whether a thread of the system starts by its own convention, at an adapter that calls the code of
// Koji (Windows), rather than at that code (System V's).
export function threadAdapters(): boolean {
    return match (targetSystem()) {
        Linux => false
        MacOS => false
        Windows => true
    }
}

// How the variable of C `environ` is reached: through the table of the linker (Linux), its address
// from _NSGetEnviron (macOS), or from __p__environ (Windows).
export type EnvironmentAccess = {
    ThroughTable
    FromFunction(name: string)
    FromCFunction(name: string)
}

export function environmentAccess(): EnvironmentAccess {
    return match (targetSystem()) {
        Linux => ThroughTable
        MacOS => FromFunction('_NSGetEnviron')
        Windows => FromCFunction('__p__environ')
    }
}

// The sleep of the ticker of the runtime, 10 ms: nanosleep, or Sleep of Windows (in milliseconds).
export function sleepsInMilliseconds(): boolean {
    return match (targetSystem()) {
        Linux => false
        MacOS => false
        Windows => true
    }
}

// The name of the system for messages and for KOJI_TARGET (`windows-x64`).
export function systemName(): string {
    return match (targetSystem()) {
        Linux => 'linux'
        MacOS => 'macos'
        Windows => 'windows'
    }
}

// Whether the switch between the stacks of tasks also saves the limits of the stack in the block of
// the thread (Windows, whose functions check them: StackBase, StackLimit).
export function stackLimitsInThread(): boolean {
    return match (targetSystem()) {
        Linux => false
        MacOS => false
        Windows => true
    }
}

// How a program on arm64 knows whether the processor has the instructions of AES and PMULL: they
// always are on macOS (Apple's processors); Linux tells it (getauxval(AT_HWCAP): bits 3 and 4).
// (On x86-64, the processor itself tells, by cpuid, whatever the system.)
export type ArmFeatures = {
    AlwaysThere
    FromAuxiliaryVector
    NoArmBuild
}

export function armFeatures(): ArmFeatures {
    return match (targetSystem()) {
        Linux => FromAuxiliaryVector
        MacOS => AlwaysThere
        Windows => NoArmBuild
    }
}
